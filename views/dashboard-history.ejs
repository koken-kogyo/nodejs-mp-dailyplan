<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>ダッシュボード</title>
    <!-- View -->
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- CSS -->
    <link rel="stylesheet" href="/static/css/style-dashboard.css">
    <!-- Script -->
    <script src="/static/javascripts/chart.umd.min.js"></script>
</head>
<body>
    <!-- Common JavaScript -->
    <%- include("_myfunctions.ejs") %>
    <% let osType = myRequestHeader.osType(req); %>

    <!-- Main-Container -->
    <div id="main" class="containers">

        <!-- Header -->
        <header>
            生産ダッシュボード
            <div id="titledatetime">2025年9月15日(火) 13時41分</div>
        </header>

        <!-- Details -->
        <div id="detail" class="slidr-wrap-main <%= locals.animation %>">
            <canvas id="ex_chart"></canvas>
        </div>
        <a href="javascript:toDashboard();"><div id="btnnext" class="arrowleft"></div></a>
        
        <!-- Footer -->
        <footer>
    	    <a id="copyright">&copy; 2025 Koken Kogyo Co. All rights reserved.</a>
            <a id="responsible"></a>
        </footer>
    
    </div>
    <!-- ブラウザ読み込み完了後のJavaScriptを記述 -->
    <script>
        // オブジェクト変数
        const mainObj = document.getElementById("main");
        const detailObj = document.getElementById("detail");


        var ctx = document.getElementById('ex_chart');

        var data = {
            labels: ["令和元年", "令和2年", "令和3年", "令和4年", "令和5年"],
            datasets: [{
                label: '得点',
                data: [880, 740, 900, 520, 930],
                backgroundColor: 'rgba(255, 100, 100, 1)'
            }]
        };
        var options = {
            indexAxis: 'y',
            scales: {
                x:{
                    min: 300
                }
            }
        };
        var ex_chart = new Chart(ctx, {
            type: 'bar',
            data: data,
            options: options
        });

        // 未来へ移動
        function toDashboard() {
            detailObj.className = "slideout_toleft";
            setTimeout(() => {window.location.href = "/mp/todashboard/fromhistory";}, 100);
        }

        // ******************* ウィンドウズのデバイス対応 *************************
        // キーボードイベントを監視
        document.addEventListener("keydown", function(event) {
            switch (event.key) {
                case "ArrowRight":  // 右矢印キー
                    toDashboard();
                    break;
                default:            // 他のキーは無視
                    break;
            }
        });

    </script>

</body>
</html>
