<!DOCTYPE html>
<html lang="ja">
<head>
    <title>切削業務メニュー</title>
    <meta charset="UTF-8">
    <!-- CSS -->
    <link rel="stylesheet" href="/static/css/style-basic.css">
    <link rel="stylesheet" href="/static/css/style-index.css">
    <link href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" rel="stylesheet">
    <!-- View -->
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- ICON -->
    <link rel="icon" href="/static/images/favicon.ico" sizes="32x32">
</head>
<body>
<div>
    <!-- Common JavaScript EJS -->
    <%- include("_myfunctions.ejs") %>

    <!-- Header -->
	<header>
	    <header1 id="logo"><a href="/">コーケン工業</a></header1>
		<header2 id="menutitle">切削業務メニュー</header2>
        <div id="userinfo">
            <% if (req.session.userid) { %>
                <%= req.session.jpname %>&nbsp;&nbsp;<a href="/logout">ログアウト</a>
            <% } else { %>
                ゲスト さん&nbsp;&nbsp;<a href="/login">ログイン</a>
            <% }; %>
        </div>
        <header3 id="settings"><a href="/settings"><img src="/static/images/settings.png" height="26px"></a></header3>
    </header>

    <!-- contents -->
    <div id="top"></div>
    
    <% if (locals.err) { %>
        <ul class="alert">
            <li><%= err %></li>
        </ul>
    <% } %>

    <div class="containers">
        <!-- 手動機手配一覧 -->
        <div class="item-title">
            <i class="fas fa-paw"></i> 手動機 手配一覧
        </div>
        <div class="item">
            <a href="/mp/order/sw" target="_blank">
                <div class="text-amazing-m">SW</div>
            </a>
        </div>
        <div class="item">
            <a href="/mp/order/nc" target="_blank">
                <div class="text-amazing-m">NC</div>
            </a>
        </div>
        <div class="item">
            <a href="/mp/order/mc" target="_blank">
                <div class="text-amazing-m">MC</div>
            </a>
        </div>
        <div class="item">
            <a href="/mp/order/3BP" target="_blank">
                <div class="text-amazing-m">3BP</div>
            </a>
        </div>
        <div class="item">
            <a href="/mp/order/ON" target="_blank">
                <div class="text-amazing-m">S500</div>
            </a>
        </div>
        <div></div>
        <div class="item">
            <a href="/mp/order/lf" target="_blank">
                <div class="text-amazing-m">LF</div>
            </a>
        </div>
        <div class="item">
            <a href="/mp/order/tp" target="_blank">
