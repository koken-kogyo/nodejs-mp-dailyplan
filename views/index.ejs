        <div class="item-title">
            <i class="fas fa-paw"></i> その他
        </div>
        <div class="item">
            <a href="/mp/viewreport/sw" target="_blank">
                <div class="text-amazing-m">SW日報</div>
            </a>
        </div>
        <div class="item" onclick="window.open('/mp/dashboard','_blank');" style="cursor: pointer;"><div class="text-amazing-m">Dash Board</div></div>
        <div class="item-nothing"></div>
        <div class="item-nothing"></div>
        <div class="item-nothing"></div>
        <div class="item-nothing"></div>
    </div>

    <!-- Footer -->
    <%- include("_footer.ejs", req) %>
