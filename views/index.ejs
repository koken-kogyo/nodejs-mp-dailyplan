        </div>
        <div class="item">
            <a href="/mp/order/d" target="_blank">
                <div class="text-amazing-m">D</div>
            </a>
        </div>
        <!-- 自動機手配一覧 -->
        <div class="item-title">
            <i class="fas fa-paw"></i> 自動機 手配一覧
        </div>
        <div class="item">
            <a href="/mp/order/ss" target="_blank">
                <div class="text-amazing-a">SS</div>
