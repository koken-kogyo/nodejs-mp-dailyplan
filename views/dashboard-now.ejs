let lastTap = 0;

document.getElementById("myElement").addEventListener("touchend", function (e) {
  const currentTime = new Date().getTime();
  const tapLength = currentTime - lastTap;

  if (tapLength < 300 && tapLength > 0) {
    alert("ダブルタップされました！");
  }

  lastTap = currentTime;
});
*/



    </script>

</body>
</html>
