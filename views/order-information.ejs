        // 時間を置いてからタブを閉じる
        async function browserTabClose(){            
            const sleepByPromise = (ms) => new Promise(resolve => setTimeout(resolve, ms));
            await sleepByPromise(5000);
            window.close();
            if (!window.closed) {
                alert("xボタンを押して閉じて下さい．\n\n(ブラウザの履歴が残っていると自動で閉じることが出来ない)");
            }
        }

