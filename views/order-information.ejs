<!DOCTYPE html>
<html lang="ja">
<head>
    <!-- meta -->
    <meta charset="UTF-8">
    <meta name="format-detection" content="telephone=no">    
    <title>手配一覧</title>
    <!-- CSS -->
    <link rel="stylesheet" href="/static/css/style-basic.css">
    <link rel="stylesheet" href="/static/css/style-mppages.css">
    <link rel="stylesheet" href="/static/css/style-jsQR.css"/>
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css" >
    <!-- JavaScript -->
    <script src="/static/javascripts/_myfunctions.js"></script>
    <script src="/static/javascripts/jsQR.js" defer></script>
    <script src="/static/javascripts/jsQR-main.js" defer></script>
</head>

<!--body>
QRコード読取
    <h1>jsQR</h1>
    <div id="wrapper">
        <div id="msg">Unable to access video stream.</div>
        <canvas id="canvas"></canvas>
    </div>
</body -->

<body>
    <!-- Common JavaScript -->
    <%- include("_myfunctions.ejs") %>
    <% let osType = myRequestHeader.osType(req); %>

    <div id="top"></div>
    <div id="main" class="containers">

    <!-- Header -->
    <%- include("_header.ejs", { title: mcgcd + "工程　手配一覧", req }) %>
    <div id="gotoswmenu"><a href="javascript:window.close()"><i class="fas fa-home"></i></a></div>
    <input type="hidden" id="mcgcd" name="mcgcd" value="<%= mcgcd %>" />
    <input type="hidden" id="starteddt" name="starteddt" value="<%= ymds[0] %>" />
    <% let idx = 0; %><% ymds.forEach(function (e) { %><input type="hidden" id="eddt<%= idx %>" name="eddt<%= idx %>" value="<%= e %>" />
    <% idx++; %><% }); %>

    <!-- Details -->
    <div id="details">
    <% if (locals.err) { %>
        <ul class="alert">
            <li><%= err.message %></li>
        </ul>
    <% } %>
    <% if (kd8450) { %>
        <% let tableno = 1; %>
        <% let mccount = Object.keys(kd8450).length; %>
        <% kd8450.forEach(function (data) { %>
            <div id="jump<%= tableno %>"></div>
            <input type="hidden" id="mccd<%= tableno %>" name="mccd<%= tableno %>" value="<%= data[0].MCCD %>" />
            <!-- 設備タイトル -->
            <div class="mcnm">
                <%= data[0].MCCD %>：<%= data[0].MCNM; %>
                <span class="smalltitle">
                <%= (data[0].CUTTHICKNESS==0) ? "（刃厚設定なし）" : "（刃厚：" + data[0].CUTTHICKNESS; %>
                <%= (data[0].SCRAPLEN==0) ? "" : "、端材長さ：" + data[0].SCRAPLEN + "）"; %>
                <input type="hidden" id="mcthick<%= tableno %>" name="mcthick" value="<%= data[0].CUTTHICKNESS %>" />
                <input type="hidden" id="mcscrap<%= tableno %>" name="mcscrap" value="<%= data[0].SCRAPLEN %>" />
                </span>
                <span class="floatright">
                <!-- チェックボックス関連 -->
                <label class="check-disp">
                    <input type="checkbox" id="chktehai<%= tableno %>" class="check-box" title="手配情報" value="<%= tableno %>" onchange="checkTehaiChange(this.value)"/>
                    全て<span id ="countResult<%= tableno %>" class="normaltitle">-</span>&nbsp;&nbsp;
                </label>
                <label class="check-disp">
                    <input type="checkbox" id="chkcycletime<%= tableno %>" class="check-box" title="CT" value="<%= tableno %>" onchange="checkCTChange(this.value)"/>
                    CT&nbsp;&nbsp;
                </label>
                <label class="check-disp">
                    <input type="checkbox" id="chkzaiko<%= tableno %>" class="check-box" title="在庫状況" value="<%= tableno %>" onchange="checkZaikoChange(this.value)"/>
                    在庫&nbsp;&nbsp;
                </label>
                <label class="check-disp">
                    <input type="checkbox" id="chkmate<%= tableno %>" class="check-box" title="鋼材情報" value="<%= tableno %>" onchange="checkMateChange(this.value)"/>
                    鋼材
                </label>
                <% let prevsectionid = "jump" + (tableno - 1); %>
                <% let nextsectionid = "jump" + (tableno + 1); %>
                <% if (tableno == 2) { %>
                    <a href="#top" class="td-apem-a">前へ</a>
                <% } %>
                <% if (tableno >= 3) { %>
                    <a href="javascript:jumpToSection('<%= prevsectionid %>')" class="td-apem-a">&nbsp;&nbsp;前へ&nbsp;&nbsp;</a>
                <% } %>
                <% if (tableno != mccount) { %>
                    <a href="javascript:jumpToSection('<%= nextsectionid %>')" class="td-apem-a">&nbsp;&nbsp;次へ&nbsp;&nbsp;</a>
                <% } %>
                </span>
            </div>
            <hr>
            <!-- 明細 cells[x] -->
            <!--  0:品番 -->
            <!--  1:品目名称 -->
            <!--  2:材料 -->
            <!--  3:長さ -->
            <!--  4:遅れ -->
            <!--  5:～10:W -->
            <!--  11:～16:1W -->
            <!--  17:CT -->
            <!--  18:注文残 -->
            <!--  19:仕掛り在庫数 -->
            <!--  20:タナコン在庫数 -->
            <!--  21:材料長さ -->
            <!--  22:帳票定義ID(ボタン) -->
            <% if (Object.keys(data[1]).length == 0) { %>
                <div class="nodata">データありません．</div>
            <% } else { %>
                <table id="tbl<%= tableno %>">
                    <tr>
                        <th width="160px">品番</th>
                        <th width="150px">品目名称</th>
                        <th width="40px">材料</th>
                        <th width="60px">長さ</th>
                        <th class="th-qty">遅れ</th>
                        <% for (let i = 1; i <= 10; i++) { %>
                            <th class="th-qty"><%= myFunc.a(ymds[i-1]); %><br><%= myFunc.m(ymds[i-1]); %></th>
                            <% if (i % 5 == 0) { %>
                                <th width="40px">合計<br>時間</th>
                            <% } %>
                        <% } %>
                        <th width="40px">CT</th>
                        <th width="50px">注文残</th>
                        <th width="50px">仕掛</th>
                        <th width="50px">ﾀﾅｺﾝ</th>
                        <th width="100px">鋼材長さ</th>
                        <th width="80px">ﾁｪｯｸｼｰﾄ</th>
                        
                    </tr>
                    <% let cntA = 0; %>
                    <% let cnt0 = 0; %>
                    <% let cnt1 = 0; %>
                    <% let cnt2 = 0; %>
                    <% let cnt3 = 0; %>
                    <% let cnt4 = 0; %>
                    <% let cnt5 = 0; %>
                    <% let cnt6 = 0; %>
                    <% let cnt7 = 0; %>
                    <% let cnt8 = 0; %>
                    <% let cnt9 = 0; %>
                    <% let sumA = 0; %>
                    <% let sum0 = 0; %>
                    <% let sum1 = 0; %>
                    <% let sum2 = 0; %>
                    <% let sum3 = 0; %>
                    <% let sum4 = 0; %>
                    <% let sum5 = 0; %>
                    <% let sum6 = 0; %>
                    <% let sum7 = 0; %>
                    <% let sum8 = 0; %>
                    <% let sum9 = 0; %>
                    <% let sumct1 = 0; %>
                    <% let sumct2 = 0; %>
                    <% data[1].forEach(function (d) { %>
                    <tr>
                        <td class="tdrow lef td-big">
                            <% if (osType == "windows") { %>
                                <a href="javascript:apemCustomURL(0, '<%= d.HMCD %>')" class="td-apem-a"><%= d.HMCD %></a>
                            <% } else { %>
                                <a href="javascript:apemCustomURL(1, '<%= d.HMCD %>')" class="td-apem-a"><%= d.HMCD %></a>
                            <% }; %>
                        </td>
                        <td class="tdrow lef"><%= d.HMNM %></td>
                        <td class="tdrow"><%= d.MATESIZE %></td>
                        <td class="tdrow"><%= d.LENGTH %></td>
                        <!-- 遅れ -->
                        <% if (Number(d.DA)!=Number(d.DAZ) && Number(d.DAZ)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.DAZ)/Number(d.DA)*100) %>%;"><%= d.DA %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STSA %>"><%= d.DA %></td>
                        <% } %>
                        <!-- W -->
                        <% if (Number(d.D0)!=Number(d.D0Z) && Number(d.D0Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D0Z)/Number(d.D0)*100) %>%;"><%= d.D0 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS0 %>"><%= d.D0 %></td>
                        <% } %>
                        <% if (Number(d.D1)!=Number(d.D1Z) && Number(d.D1Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D1Z)/Number(d.D1)*100) %>%;"><%= d.D1 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS1 %>"><%= d.D1 %></td>
                        <% } %>
                        <% if (Number(d.D2)!=Number(d.D2Z) && Number(d.D2Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D2Z)/Number(d.D2)*100) %>%;"><%= d.D2 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS2 %>"><%= d.D2 %></td>
                        <% } %>
                        <% if (Number(d.D3)!=Number(d.D3Z) && Number(d.D3Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D3Z)/Number(d.D3)*100) %>%;"><%= d.D3 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS3 %>"><%= d.D3 %></td>
                        <% } %>
                        <% if (Number(d.D4)!=Number(d.D4Z) && Number(d.D4Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D4Z)/Number(d.D4)*100) %>%;"><%= d.D4 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS4 %>"><%= d.D4 %></td>
                        <% } %>
                        <% let ct1 = (Number(d.D0)+Number(d.D1)+Number(d.D2)+Number(d.D3)+Number(d.D4)) * d.CT; %>
                        <td class="tdrow"><%= (ct1 == 0) ? "" : (Math.round((ct1 / 3600) * 10) / 10).toFixed(1); %></td>
                        <!-- 1W -->
                        <% if (Number(d.D5)!=Number(d.D5Z) && Number(d.D5Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D5Z)/Number(d.D5)*100) %>%;"><%= d.D5 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS5 %>"><%= d.D5 %></td>
                        <% } %>
                        <% if (Number(d.D6)!=Number(d.D6Z) && Number(d.D6Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D6Z)/Number(d.D6)*100) %>%;"><%= d.D6 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS6 %>"><%= d.D6 %></td>
                        <% } %>
                        <% if (Number(d.D7)!=Number(d.D7Z) && Number(d.D7Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D7Z)/Number(d.D7)*100) %>%;"><%= d.D7 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS7 %>"><%= d.D7 %></td>
                        <% } %>
                        <% if (Number(d.D8)!=Number(d.D8Z) && Number(d.D8Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D8Z)/Number(d.D8)*100) %>%;"><%= d.D8 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS8 %>"><%= d.D8 %></td>
                        <% } %>
                        <% if (Number(d.D9)!=Number(d.D9Z) && Number(d.D9Z)>0) { %>
                            <td class="tdrow td-qty s3" style="--remain-per: <%= Math.round(Number(d.D9Z)/Number(d.D9)*100) %>%;"><%= d.D9 %></td>
                        <% } else { %>
                            <td class="tdrow td-qty s<%= d.STS9 %>"><%= d.D9 %></td>
                        <% } %>
                        <% let ct2 = (Number(d.D5)+Number(d.D6)+Number(d.D7)+Number(d.D8)+Number(d.D9)) * d.CT; %>
                        <td class="tdrow"><%= (ct2 == 0) ? "" : (Math.round((ct2 / 3600) * 10) / 10).toFixed(1); %></td>
                        <!-- CT -->
                        <td class="tdrow"><%= (d.CT == 0) ? "" : d.CT + "s"; %></td>
                        <% let zanqty = Number(d.DAZ)+Number(d.D0Z)+Number(d.D1Z)+Number(d.D2Z)+Number(d.D3Z)+Number(d.D4Z)+Number(d.D5Z)+Number(d.D6Z)+Number(d.D7Z)+Number(d.D8Z)+Number(d.D9Z); %>
                        <td class="tdrow"><%= zanqty; %></td>
                        <td class="tdrow"><%= (d.ZAIQTY == 0) ? "" : Number(d.ZAIQTY).toLocaleString(); %></td>
                        <td class="tdrow"><%= (d.STORE == 0) ? "" : Number(d.STORE).toLocaleString(); %></td>
                        <td class="tdrow"><%= d.MATERIALLEN %></td>
                        <td class="tdrow"><%= (d.DEFID == 0) ? "" : d.DEFID %></td>
                    </tr>
                    <% cntA += (Number(d.DA) > 0) ? 1 : 0; %>
                    <% cnt0 += (Number(d.D0) > 0) ? 1 : 0; %>
                    <% cnt1 += (Number(d.D1) > 0) ? 1 : 0; %>
                    <% cnt2 += (Number(d.D2) > 0) ? 1 : 0; %>
                    <% cnt3 += (Number(d.D3) > 0) ? 1 : 0; %>
                    <% cnt4 += (Number(d.D4) > 0) ? 1 : 0; %>
                    <% cnt5 += (Number(d.D5) > 0) ? 1 : 0; %>
                    <% cnt6 += (Number(d.D6) > 0) ? 1 : 0; %>
                    <% cnt7 += (Number(d.D7) > 0) ? 1 : 0; %>
                    <% cnt8 += (Number(d.D8) > 0) ? 1 : 0; %>
                    <% cnt9 += (Number(d.D9) > 0) ? 1 : 0; %>
                    <% sumA += (Number(d.DA) > 0) ? Number(d.DA) : 0; %>
                    <% sum0 += (Number(d.D0) > 0) ? Number(d.D0) : 0; %>
                    <% sum1 += (Number(d.D1) > 0) ? Number(d.D1) : 0; %>
                    <% sum2 += (Number(d.D2) > 0) ? Number(d.D2) : 0; %>
                    <% sum3 += (Number(d.D3) > 0) ? Number(d.D3) : 0; %>
                    <% sum4 += (Number(d.D4) > 0) ? Number(d.D4) : 0; %>
                    <% sum5 += (Number(d.D5) > 0) ? Number(d.D5) : 0; %>
                    <% sum6 += (Number(d.D6) > 0) ? Number(d.D6) : 0; %>
                    <% sum7 += (Number(d.D7) > 0) ? Number(d.D7) : 0; %>
                    <% sum8 += (Number(d.D8) > 0) ? Number(d.D8) : 0; %>
                    <% sum9 += (Number(d.D9) > 0) ? Number(d.D9) : 0; %>
                    <% sumct1 += (ct1 > 0) ? ct1 : 0; %>
                    <% sumct2 += (ct2 > 0) ? ct2 : 0; %>
                    <% }); %>
                    <tr>
                        <td class="thsum" colspan="3">合計</td>
                        <td></td>
                        <td class="tdsum"><%= (sumA > 0) ? sumA.toLocaleString() : ""; %><br><%= (cntA > 0) ? "(" + cntA + ")" : "" %></td>
                        
                        <td class="tdsum"><%= (sum0 > 0) ? sum0.toLocaleString() : ""; %><br><%= (cnt0 > 0) ? "(" + cnt0 + ")" : "" %></td>
                        <td class="tdsum"><%= (sum1 > 0) ? sum1.toLocaleString() : ""; %><br><%= (cnt1 > 0) ? "(" + cnt1 + ")" : "" %></td>
                        <td class="tdsum"><%= (sum2 > 0) ? sum2.toLocaleString() : ""; %><br><%= (cnt2 > 0) ? "(" + cnt2 + ")" : "" %></td>
                        <td class="tdsum"><%= (sum3 > 0) ? sum3.toLocaleString() : ""; %><br><%= (cnt3 > 0) ? "(" + cnt3 + ")" : "" %></td>
                        <td class="tdsum"><%= (sum4 > 0) ? sum4.toLocaleString() : ""; %><br><%= (cnt4 > 0) ? "(" + cnt4 + ")" : "" %></td>
                        <td class="thsum">
                            <%= (sumct1 > 0) ? (Math.round((sumct1 / 3600) * 10) / 10).toFixed(1) : ""; %><br>
                            <%= (sumct1 > 0) ? "(" + (Math.round((sumct1 / 3600) * 10 / 5) / 10).toFixed(1) + ")" : ""; %>
                        </td>
                        <td class="tdsum"><%= (sum5 > 0) ? sum5.toLocaleString() : ""; %><br><%= (cnt5 > 0) ? "(" + cnt5 + ")" : "" %></td>
                        <td class="tdsum"><%= (sum6 > 0) ? sum6.toLocaleString() : ""; %><br><%= (cnt6 > 0) ? "(" + cnt6 + ")" : "" %></td>
                        <td class="tdsum"><%= (sum7 > 0) ? sum7.toLocaleString() : ""; %><br><%= (cnt7 > 0) ? "(" + cnt7 + ")" : "" %></td>
                        <td class="tdsum"><%= (sum8 > 0) ? sum8.toLocaleString() : ""; %><br><%= (cnt8 > 0) ? "(" + cnt8 + ")" : "" %></td>
                        <td class="tdsum"><%= (sum9 > 0) ? sum9.toLocaleString() : ""; %><br><%= (cnt9 > 0) ? "(" + cnt9 + ")" : "" %></td>
                        <td class="thsum">
                            <%= (sumct2 > 0) ? (Math.round((sumct2 / 3600) * 10) / 10).toFixed(1) : ""; %><br>
                            <%= (sumct2 > 0) ? "(" + (Math.round((sumct2 / 3600) * 10 / 5) / 10).toFixed(1) + ")" : ""; %>
                        </td>
                        <td class="tdsum">*</td>
                        <td class="tdsum"></td>
                        <td class="tdsum"></td>
                        <td class="tdsum"></td>
                        <td class="tdsum"></td>
                        <td class="tdsum"></td>
                    </tr>
                </table>
            <% }; %>
            <% tableno += 1; %>
            <br><br>
        <% }); %>
    <% }; %>
    </div>
    </div>


    <!-- Footer -->
    <div id="goback"><a href="javascript:history.back()">[戻る]</a></div>
    <div id="gotop"><a href="#">ページの先頭に戻る</div>
    <%- include("_footer.ejs", req) %>
    
    <!-- 仕掛り在庫訂正 Popup Window -->
    <%- include("_popup-zaiko.ejs") %>
    <script src="/static/javascripts/_popup-zaiko.js"></script>

    <!-- 実績入力 Popup Window -->
    <%- include("_popup-jisseki.ejs") %>
    <script src="/static/javascripts/_popup-jisseki.js"></script>

    <!-- i-Reporter選択 Popup Window width: 700px -->
    <%- include("_popup-ireporter.ejs") %>
    <script src="/static/javascripts/_popup-ireporter.js"></script>

    <!-- ブラウザ読み込み完了後のJavaScriptを記述 -->
    <script>
        // ブラウザ読み込み完了後の初期設定
        SetInitialValues();

        // ブラウザ読み込み完了後の初期設定
        function SetInitialValues() {
            const myos = myOS(); // OSによってデフォルト表示を切り替える
            // テーブルの数分ループ処理
            for (tblno = 1; tblno < 15; tblno++){
                const tblobj = document.getElementById(`tbl${tblno}`);
                let compcount = 0; // 完了数
                if (tblobj) {
                    // 各テーブル内のデータ数分ループ処理
                    const endcol = tblobj.rows[1].cells.length - 1;
                    const endcol2 = tblobj.rows[tblobj.rows.length - 1].cells.length - 1;
                    const thickness = Number(document.getElementById(`mcthick${tblno}`).value);     // 刃厚さ
                    const scraplen = Number(document.getElementById(`mcscrap${tblno}`).value);      // 端材長さ
                    let mateold = tblobj.rows[1].cells[2].innerHTML;
                    let colorno = 0;
                    for ( var i = 1; i < tblobj.rows.length - 1; i++ ) {
                        // ０．変数セット
                        const productlen = Number(tblobj.rows[i].cells[3].innerHTML);               // 製品長さ
                        const materiallen = Number(tblobj.rows[i].cells[endcol - 1].innerHTML);     // 材料長さ
                        const zanqty = Number(tblobj.rows[i].cells[endcol - 4].innerHTML);          // 注文残数
                        const storeqty = Number(tblobj.rows[i].cells[endcol - 2].innerHTML);        // タナコン在庫数
                        
                        // １．材料サイズ毎の色分け処理
                        const matenow = tblobj.rows[i].cells[2].innerHTML;
                        if (matenow != mateold) {
                            colorno = (colorno == 0) ? 1 : 0;
                            mateold = matenow;
                        }

                        // １．５ タナコン在庫数のチェック
                        if (zanqty > storeqty) {
                            tblobj.rows[i].cells[endcol - 2].className = "warn";
                        }

                        // ２．鋼材情報行の追加
                        var newrow = tblobj.insertRow(i + 1);
                        appendTD(newrow, "", "center", 5);
                        appendTD(newrow, "", "center", 5);
                        appendTD(newrow, "", "center", 1);
                        appendTD(newrow, "", "center", 5);
                        appendTD(newrow, "", "center", 1);
                        appendTD(newrow, "", "center", 7);

                        // ３．鋼材使用長さの集計と、仕掛在庫の消込処理を同時に行う
                        let usedlenttl = Number("0.0");
                        for (var j=5; j<=11; j+=6) {
                            let usedlen = Number("0.0"); // 一週間で使用する鋼材長さを集計
                            for (var k=0; k<5; k++) {
                                if (!isNaN(tblobj.rows[i].cells[j+k].innerText) && tblobj.rows[i].cells[j+k].innerText != "") {
                                    // 3.1
                                    if (tblobj.rows[i].cells[j+k].classList.contains("s4") == false) {
                                        let qty = Number(tblobj.rows[i].cells[j+k].innerText);
                                        // 製品長さが入っていたら加算
                                        if (productlen > 0) {
                                            usedlen += (productlen + thickness) * qty;
                                            usedlenttl += (productlen + thickness) * qty;
                                        }
                                    }
                                    // 3.2 イベントハンドラー（実績入力ポップアップ呼び出し）
                                    const strQTY = tblobj.rows[i].cells[j+k].innerText;
                                    tblobj.rows[i].cells[j+k].innerHTML =
                                    `<a href="javascript:jissekiPopup(${tblno},${i},${j+k},'ORDER')" class="td-qty-a">` + strQTY + "</a>" ;
                                }
                            }
                            // 小数点第3位は切り捨て
                            if (usedlen > 0) {
                                var usedmate = Math.floor(usedlen / (materiallen - scraplen) * 100) / 100;
                                var usedmaterialtext = (materiallen==0) ? "鋼材長さ設定なし" : usedmate + "本";
                                tblobj.rows[i + 1].cells[(j==5) ? 1 : 3].innerText = usedmaterialtext + 
                                    " (" + usedlen.toLocaleString() + "mm)";
                            }
                        }
                        // ３．２ 仕掛在庫訂正ポップアップイベントリスナー設定
                        let waitqty = Number(tblobj.rows[i].cells[endcol - 3].innerText.replace(",",""));
                        if (waitqty == 0) {
                            tblobj.rows[i].cells[endcol - 3].innerHTML = `<a href="javascript:zaiqtyPopup(${tblno},${i})" class="td-zai-a"></a>`;
                            tblobj.rows[i].cells[endcol - 3].style.cursor = "pointer";
                        } else {
                            tblobj.rows[i].cells[endcol - 3].innerHTML = `<a href="javascript:zaiqtyPopup(${tblno},${i})" class="td-zai-a">` + waitqty + "</a>" ;
                            tblobj.rows[i].cells[endcol - 3].style.cursor = "pointer";
                        }
                        // ４．鋼材使用長さの集計結果を反映
                        if (usedlenttl > 0) {
                            var str = "材料：" + tblobj.rows[i].cells[2].innerHTML;
                            str += "、長さ：" + tblobj.rows[i].cells[3].innerHTML;
                            tblobj.rows[i + 1].cells[0].innerHTML = str;
                            tblobj.rows[i + 1].cells[0].className = "lef";
                            // 使用集計値 / (材料長さ-端材長さ) 100倍して小数点切り捨てして100で割って小数点以下第２位までを求める
                            var usedmate = Math.floor(usedlenttl / (materiallen - scraplen) * 100) / 100;
                            var usedmaterialtext = (materiallen==0) ? "鋼材長さ設定なし" : usedmate + "本";
                            tblobj.rows[i + 1].cells[5].innerText = usedmaterialtext + 
                                " (" + usedlenttl.toLocaleString() + "mm)";
                            }
                        // ５．材料の種類毎に背景色を変える
                        tblobj.rows[i + 0].style.backgroundColor = (colorno == 0) ? "#FEFEFE" : "#ECECEC";
                        tblobj.rows[i + 1].style.backgroundColor = (colorno == 0) ? "#FEFEFE" : "#ECECEC";
                        // ６．イベントハンドラー（i-Repo呼び出し）
                        if (tblobj.rows[i].cells[endcol].innerHTML != "") {
                            tblobj.rows[i].cells[endcol].innerHTML = `<a href="javascript:iReporter(${tblno},${i})" class="btn-irepo">` + "記入" + "</a>" ;
                        }
                        // ７．列(TD)の非表示化
                        tblobj.rows[i].cells[3].style.display = "none";                 // 長さ
                        tblobj.rows[i].cells[endcol - 1].style.display = "none";        // 鋼材長さ
                        tblobj.rows[i].cells[10].style.display = "none";                // CT1
                        tblobj.rows[i].cells[16].style.display = "none";                // CT2
                        tblobj.rows[i].cells[17].style.display = "none";                // CT
                        if (myos != "windows") {
                            tblobj.rows[i].cells[endcol - 4].style.display = "none";    // 注文残
                            tblobj.rows[i].cells[endcol - 3].style.display = "none";    // 仕掛かり在庫数
                            tblobj.rows[i].cells[endcol - 2].style.display = "none";    // ストア在庫数
                        }
                        // ８．行(TR)の非表示化
                        tblobj.rows[i + 1].style.display = "none";    // 8.1.鋼材情報行は一旦非表示
                        if (zanqty == 0) {
                            tblobj.rows[i].style.display = "none";    // 8.2.注文残数が0の場合一旦非表示
                            compcount++;
                        }
                        // insertRowした分を加算
                        i++;
                    }
                    // 合計数量の表示
                    document.getElementById(`countResult${tblno}`).innerText =
                        `(完了${compcount}件 / ${(tblobj.rows.length-2)/2}件)`;

                    // ヘッダー(TH)の非表示化
                    tblobj.rows[0].cells[3].style.display = "none";                     // 長さ
                    tblobj.rows[0].cells[endcol - 1].style.display = "none";            // 鋼材長さ
                    tblobj.rows[0].cells[10].style.display = "none";                    // CT1
                    tblobj.rows[0].cells[16].style.display = "none";                    // CT2
                    tblobj.rows[0].cells[17].style.display = "none";                    // CT
                    // 合計行の非表示化
                    tblobj.rows[i].cells[1].style.display = "none";                     // 長さ
                    tblobj.rows[i].cells[endcol2 - 1].style.display = "none";           // 鋼材長さ
                    tblobj.rows[i].cells[8].style.display = "none";                     // CT1
                    tblobj.rows[i].cells[14].style.display = "none";                    // CT2
                    tblobj.rows[i].cells[15].style.display = "none";                    // CT
                    // windows以外は非表示化
                    if (myos != "windows") {
                        tblobj.rows[0].cells[endcol - 4].style.display = "none";        // 注文残
                        tblobj.rows[0].cells[endcol - 3].style.display = "none";        // 仕掛かり在庫数
                        tblobj.rows[0].cells[endcol - 2].style.display = "none";        // ストア在庫数
                    } else {
                        document.getElementById(`chkzaiko${tblno}`).checked = true;
                    }
                }
            }
        }
        // 列の追加
        function appendTD(newrow, str, name, colspan){
            let newCell = newrow.insertCell();
            let newText = document.createTextNode(str);
            newCell.appendChild(newText);
            if (colspan != "") newCell.setAttribute("colspan", colspan);
            if (name != "") newCell.className = name;
        }

        // 指定した要素の位置までスクロール
        function jumpToSection(sectionId) {
            document.getElementById(sectionId).scrollIntoView({block: "center", behavior: "smooth"});
        }

        // チェックボックス手配情報の表示切り替え
        function checkTehaiChange(tblno) {
            const checkTehai = document.getElementById(`chktehai${tblno}`)
            const checkCT = document.getElementById(`chkcycletime${tblno}`)
            const checkZaiko = document.getElementById(`chkzaiko${tblno}`)
            const checkMaterial = document.getElementById(`chkmate${tblno}`)
            const tblobj = document.getElementById(`tbl${tblno}`);
            const rows = tblobj.rows.length;
            const endcol = tblobj.rows[1].cells.length - 1;
            let zanqty = 0;
            // alert(tblobj.rows[2].cells[0].innerText)
            for( var i = 1; i < rows - 1; i++ ){
                if (i % 2 != 0) { //通常の行
                    zanqty = Number(tblobj.rows[i].cells[endcol - 4].innerText); // 注文残数
                    if (checkTehai.checked == true) {
                        tblobj.rows[i].style.display = "";
                        if (checkMaterial.checked) tblobj.rows[i + 1].style.display = "";
                    } else if (zanqty > 0) {
                        tblobj.rows[i].style.display = "";
                        if (checkMaterial.checked == false) tblobj.rows[i + 1].style.display = "none";
                    } else {
                        tblobj.rows[i].style.display = "none";
                        tblobj.rows[i + 1].style.display = "none";
                    }
                }
            }
        }
        // チェックボックス表示切り替え共通関数
        function checkedChange(tblno, flg, headercols, footercols) {
            const checkCT = document.getElementById(`chkcycletime${tblno}`)
            const checkMaterial = document.getElementById(`chkmate${tblno}`)
            const tblobj = document.getElementById(`tbl${tblno}`);
            headercols.forEach(col => {
                tblobj.rows[0].cells[col].style.display = (flg == false) ? "none" : "";
                if (flg)  tblobj.rows[0].cells[col].classList.add("check-sel-anime");
                if (!flg) tblobj.rows[0].cells[col].classList.remove("check-sel-anime");
            });
            for( let row = 1; row < tblobj.rows.length - 1; row++ ){
                if (row % 2 != 0) {
                    headercols.forEach(col => 
                        tblobj.rows[row].cells[col].style.display = (flg == false) ? "none" : ""
                    );
                }
                else 
                {
                    // 鋼材集計行をコントロール
                    tblobj.rows[row].style.display = (checkMaterial.checked == false) ? "none" : "";
                    if (checkMaterial.checked)
                    {
                        tblobj.rows[row].cells[2].style.display = (checkCT.checked == false) ? "none" : "";
                        tblobj.rows[row].cells[4].style.display = (checkCT.checked == false) ? "none" : "";
                    }
                }
            }
            footercols.forEach(col =>
                tblobj.rows[tblobj.rows.length - 1].cells[col].style.display = (flg == false) ? "none" : ""
            );
        }
        /*
            <-- 明細 cells[x] -->
            <!--  0:品番 -->
            <!--  1:品目名称 -->
            <!--  2:材料 -->
            <!--  3:長さ -->
            <!--  4:遅れ -->
            <!--  5:～10:W -->
            <!--  11:～16:1W -->
            <!--  17:CT -->
            <!--  18:注文残 -->
            <!--  19:仕掛り在庫数 -->
            <!--  20:タナコン在庫数 -->
            <!--  21:材料長さ -->
            <!--  22:帳票定義ID(ボタン) -->
        */
        // チェックボックスCT表示切り替え
        function checkCTChange(tblno) {
            const checkDisp = document.getElementById(`chkcycletime${tblno}`)
            checkedChange(tblno, checkDisp.checked, [10,16,17], [8,14,15]);
        }
        // チェックボックス在庫状況の表示切り替え
        function checkZaikoChange(tblno) {
            const checkDisp = document.getElementById(`chkzaiko${tblno}`)
            checkedChange(tblno, checkDisp.checked, [18,19,20], [16,17,18]);
        }
        // チェックボックス鋼材情報の表示切り替え
        function checkMateChange(tblno) {
            const checkDisp = document.getElementById(`chkmate${tblno}`)
            checkedChange(tblno, checkDisp.checked, [3,21], [1,19]);
        }

        // カスタムURLスキームによるシステム連携（apem図面サーバーへのリンク）(0:Windows, 1:iPad)
        function apemCustomURL(mode, hmcd) {
            const apemurl = "http://apemsv/PEMasterEM/docspace/sdk/";
            const modetext = (mode == 0) ? "contentView.do" : "download.do";
            const apemparam1 = 
                "?enc=UTF-8&service=cn%3Ddrep_service%40APEMSV%2Cou%3Dcomponents%2Cdc%3DAPEMEM" + 
                `&workspace=${encodeURI("図面検索")}&condition=${encodeURI("全図面検索")}&item=0%3Aoperator%3AexactlyMatch`;
            const apemparam2 = 
                `&item=0%3Avalue%3A${hmcd}&item=7%3Aoperator%3Aboolean&item=7%3Avalue%3Atrue`;
            // 図面表示またはダウンロード
            window.open(`${apemurl}${modetext}${apemparam1}${apemparam2}`, "_blank");
        }

</script>

</body>
