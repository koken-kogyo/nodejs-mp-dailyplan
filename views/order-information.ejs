<body>
    <!-- Common JavaScript -->
    <%- include("_myfunctions.ejs") %>
    <% let osType = myRequestHeader.osType(req); %>

    <div id="top"></div>
    <div id="main" class="containers">

    <!-- Header -->
    <%- include("_header.ejs", { title: mcgcd + "工程　手配一覧", req }) %>
    <div id="gotoswmenu"><a href="javascript:window.close()"><i class="fas fa-home"></i></a></div>
    <input type="hidden" id="mcgcd" name="mcgcd" value="<%= mcgcd %>" />

    <!-- 実績入力 Popup Window -->
    <div id="jiqtyPopupWindow" class="popwin-background">
        <div id="jiqtyPopup">
            <div class="popwin-modalbody">
                <div class="popwin-Title">
                    <div class="center">　　　実績入力</div>
                    <div id="jiqtyClose">閉じる</div>
                </div>
                <table id="jiqtyPopupTable">
                    <tr>
                        <th>品番</th>
                        <td id="jpopHMCD" class="popHMCD lef" colspan="3">-</td>
                    </tr>
                    <tr>
                        <th width="80px">注文番号</th>
                        <td width="110px" id="jpopODRNO">--</td>
                        <th width="80px">手配状態</th>
                        <td width="110px" id="jpopODRSTS">--</td>
                    </tr>
                    <tr>
                        <th>注文日付</th>
                        <td id="jpopEDDT">--</td>
                        <th>注文数</th>
                        <td id="jpopODRQTY">--</td>
                    </tr>
                    <tr>
                        <th>変更前</th>
                        <td id="jpopJIQTY">--</td>
                        <th>実績数</th>
                        <td><input type="number" inputmode="decimal" pattern="[0-9]*" maxlength="4" id="inputJIQTY"></td>
                        <th style="display: none">以降実績数</th>
                        <td id="jpopFUTUREODR" style="display: none">--</td>
                        <td id="jpopFUTUREQTY" style="display: none">--</td>
                    </tr>
                </table>
                <input type="hidden" id="jpopMCCD" name="jpopmccd" value="" />
                <input type="hidden" id="jpopTBLNO" name="jpoptblno" value="" />
                <input type="hidden" id="jpopROW" name="jpoprow" value="" />
                <input type="hidden" id="jpopCOL" name="jpopcol" value="" />
                <table id="jiqtyPopupCalc">
                    <tr>
                        <td class="calc-btn" onclick="javascript:w('center','center')">初</td>
                        <td class="borderless"></td>
                        <td class="calc-numpad" onclick="javascript:i('7')">7</td>
                        <td class="calc-numpad" onclick="javascript:i('8')">8</td>
                        <td class="calc-numpad" onclick="javascript:i('9')">9</td>
                        <td class="borderless"></td>
                        <td class="calc-btn" onclick="javascript:equalqty()">＝</td>
                    </tr>
                    <tr>
                        <td class="calc-btn" onclick="javascript:w('left','self-start')">上</td>
                        <td class="borderless"></td>
                        <td class="calc-numpad" onclick="javascript:i('4')">4</td>
                        <td class="calc-numpad" onclick="javascript:i('5')">5</td>
                        <td class="calc-numpad" onclick="javascript:i('6')">6</td>
                        <td class="borderless"></td>
                        <td class="calc-btn" onclick="javascript:w('right','self-start')">上</td>
                    </tr>
                    <tr>
                        <td class="calc-btn" onclick="javascript:w('left','center')">中</td>
                        <td class="borderless"></td>
                        <td class="calc-numpad" onclick="javascript:i('1')">1</td>
                        <td class="calc-numpad" onclick="javascript:i('2')">2</td>
                        <td class="calc-numpad" onclick="javascript:i('3')">3</td>
                        <td class="borderless"></td>
                        <td class="calc-btn" onclick="javascript:w('right','center')">中</td>
                    </tr>
                    <tr>
                        <td class="calc-btn" onclick="javascript:w('left','self-end')">下</td>
                        <td class="borderless"></td>
                        <td class="calc-function" onclick="javascript:inputBS()">BS</td>
                        <td class="calc-numpad" onclick="javascript:i('0')">0</td>
                        <td class="calc-function" onclick="javascript:inputClear()">C</td>
                        <td class="borderless"></td>
                        <td class="calc-btn" onclick="javascript:w('right','self-end')">下</td>
                    </tr>
                </table>
                <table id="jiqtyPopupButtons">
                    <td id="jiqtyStart" onclick="orderStart()">作業開始</td>
                    <td id="jiqtyEntry" onclick="orderEntry()">実績登録</td>
                    <td id="jiqtyModify" onclick="orderModify()">実績訂正</td>
                </table>
            </div>
        </div>
    </div>
    
    
    <!-- i-Reporter選択 Popup Window width: 700px -->
    <div id="irepoPopupWindow" class="popwin-background">
        <div id="irepoPopup">
            <div class="popwin-modalbody">
                <div class="popwin-Title">
                    <div class="center">　　　i-Reporter 帳票選択</div>
                    <div id="irepoClose" class="popwin-close">閉じる</div>
                </div>
                <table id="irepoPopupTitle">
                    <tr>
                        <th height="60px" width="60px">品番</th>
                        <td id="ipopHMCD" class="popHMCD lef" width="300px">-</td>
                        <td id="newReport" colspan="3">新規チェックシート記入</td>
                    </tr>
                </table>
                <table id="irepoPopupTable">
                    <tr>
                        <th id="oldReport" colspan="5" class="lef">Javascript可変メッセージ</th>
                    </tr>
                    <tr>
                        <th width="30px">ID</th>
                        <th width="200px">帳票名称</th>
                        <th width="50px">状態</th>
                        <th width="70px">登録日</th>
                        <th width="70px">更新日</th>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Details -->
    <div id="details">
    <% if (kd8450) { %>
        <% let tableno = 1; %>
        <% let mccount = Object.keys(kd8450).length; %>
        <% kd8450.forEach(function (data) { %>
            <div id="jump<%= tableno %>"></div>
            <input type="hidden" id="mccd<%= tableno %>" name="mccd<%= tableno %>" value="<%= data[0].MCCD %>" />
            <!-- 設備タイトル -->
            <div class="mcnm">
                <%= data[0].MCCD %>：<%= data[0].MCNM; %>
                <span class="smalltitle">
                <%= (data[0].CUTTHICKNESS==0) ? "（刃厚設定なし）" : "（刃厚：" + data[0].CUTTHICKNESS; %>
                <%= (data[0].SCRAPLEN==0) ? "" : "、端材長さ：" + data[0].SCRAPLEN + "）"; %>
                <input type="hidden" id="mcthick<%= tableno %>" name="mcthick" value="<%= data[0].CUTTHICKNESS %>" />
                <input type="hidden" id="mcscrap<%= tableno %>" name="mcscrap" value="<%= data[0].SCRAPLEN %>" />
                </span>
                <span class="floatright">
                <!-- チェックボックス関連 -->
                全て表示
                <span id ="countResult<%= tableno %>" class="normaltitle">-</span>
                <input type="checkbox" id="chktehai<%= tableno %>" class="check-box" title="手配情報" value="<%= tableno %>" onchange="checkTehaiChange(this.value)"/>
                在庫状況
                <input type="checkbox" id="chkzaiko<%= tableno %>" class="check-box" title="在庫状況" value="<%= tableno %>" onchange="checkZaikoChange(this.value)"/>
                鋼材情報
                <input type="checkbox" id="chkmate<%= tableno %>" class="check-box" title="鋼材情報" value="<%= tableno %>" onchange="checkMateChange(this.value)"/>
                <% let prevsectionid = "jump" + (tableno - 1); %>
                <% let nextsectionid = "jump" + (tableno + 1); %>
                <% if (tableno == 2) { %>
                    <a href="#top" class="td-apem-a">前へ</a>
                <% } %>
                <% if (tableno >= 3) { %>
                    <a href="javascript:jumpToSection('<%= prevsectionid %>')" class="td-apem-a">&nbsp;&nbsp;前へ&nbsp;&nbsp;</a>
                <% } %>
                <% if (tableno != mccount) { %>
                    <a href="javascript:jumpToSection('<%= nextsectionid %>')" class="td-apem-a">&nbsp;&nbsp;次へ&nbsp;&nbsp;</a>
                <% } %>
                </span>
            </div>
            <hr>
            <!-- 明細 -->
            <% if (Object.keys(data[1]).length == 0) { %>
                <div class="nodata">データありません．</div>
            <% } else { %>
                <table id="tbl<%= tableno %>">
                    <tr>
                        <th width="160px">品番</th>
                        <th width="150px">品目名称</th>
                        <th width="40px">材料</th>
                        <th width="60px">長さ</th>
                        <% ymds.forEach(function (e) { %>
                            <th class="th-qty"><%= (ymds[0]==e) ? '遅れ' : myFunc.a(e); %></th>
                            <!-- a href="/mp/plan/<%- myFunc.b(e); %>"></a -->
                        <% }); %>
                        <th width="60px">注文残</th>
                        <th width="60px">仕掛</th>
                        <th width="60px">ｽﾄｱ</th>
                        <th width="100px">鋼材長さ</th>
                        <th width="80px">ﾁｪｯｸｼｰﾄ</th>
                        
                    </tr>
                    <% data[1].forEach(function (d) { %>
                    <tr>
                        <td class="lef td-big">
                            <% if (osType == "windows") { %>
                                <a href="javascript:apemCustomURL(0, '<%= d.HMCD %>')" class="td-apem-a" target="_blank"><%= d.HMCD %></a>
                            <% } else { %>
                                <a href="javascript:apemCustomURL(1, '<%= d.HMCD %>')" class="td-apem-a" target="_blank"><%= d.HMCD %></a>
                            <% }; %>
                        </td>
                        <td class="lef"><%= d.HMNM %></td>
                        <td class=""><%= d.MATESIZE %></td>
                        <td class=""><%= d.LENGTH %></td>
                        <td class="s<%= ((Number(d.D0)!=Number(d.D0Z) && Number(d.D0Z)>0)) ? '3' : d.STS0 %> td-qty"><%= d.D0 %></td>
                        <td class="s<%= ((Number(d.D1)!=Number(d.D1Z) && Number(d.D1Z)>0)) ? '3' : d.STS1 %> td-qty"><%= d.D1 %></td>
                        <td class="s<%= ((Number(d.D2)!=Number(d.D2Z) && Number(d.D2Z)>0)) ? '3' : d.STS2 %> td-qty"><%= d.D2 %></td>
                        <td class="s<%= ((Number(d.D3)!=Number(d.D3Z) && Number(d.D3Z)>0)) ? '3' : d.STS3 %> td-qty"><%= d.D3 %></td>
                        <td class="s<%= ((Number(d.D4)!=Number(d.D4Z) && Number(d.D4Z)>0)) ? '3' : d.STS4 %> td-qty"><%= d.D4 %></td>
                        <td class="s<%= ((Number(d.D5)!=Number(d.D5Z) && Number(d.D5Z)>0)) ? '3' : d.STS5 %> td-qty"><%= d.D5 %></td>
                        <td class="s<%= ((Number(d.D6)!=Number(d.D6Z) && Number(d.D6Z)>0)) ? '3' : d.STS6 %> td-qty"><%= d.D6 %></td>
                        <td class="s<%= ((Number(d.D7)!=Number(d.D7Z) && Number(d.D7Z)>0)) ? '3' : d.STS7 %> td-qty"><%= d.D7 %></td>
                        <td class="s<%= ((Number(d.D8)!=Number(d.D8Z) && Number(d.D8Z)>0)) ? '3' : d.STS8 %> td-qty"><%= d.D8 %></td>
                        <td class="s<%= ((Number(d.D9)!=Number(d.D9Z) && Number(d.D9Z)>0)) ? '3' : d.STS9 %> td-qty"><%= d.D9 %></td>
                        <td class=""><%= Number(d.D0Z)+Number(d.D1Z)+Number(d.D2Z)+Number(d.D3Z)+Number(d.D4Z)+Number(d.D5Z)+Number(d.D6Z)+Number(d.D7Z)+Number(d.D8Z)+Number(d.D9Z) %></td>
                        <td class=""><%= (d.ZAIQTY == 0) ? "" : Number(d.ZAIQTY).toLocaleString(); %></td>
                        <td class=""><%= (d.STORE == 0) ? "" : Number(d.STORE).toLocaleString(); %></td>
                        <td class=""><%= d.MATERIALLEN %></td>
                        <td><%= (d.DEFID == 0) ? "" : d.DEFID %></td>
                    </tr>
                    <% }); %>
                </table>
            <% }; %>
            <% tableno += 1; %>
            <br><br>
        <% }); %>
    <% }; %>
    </div>
    </div>

    <!-- Footer -->
    <%- include("_footer.ejs", req) %>
    
    <!-- ブラウザ読み込み完了後のJavaScriptを記述 -->
    <script>
        // 二重送信防止フラグ
        let flgSubmit = false;

        // ブラウザ読み込み完了後の初期設定
        SetInitialValues();

        // ブラウザ読み込み完了後の初期設定
        function SetInitialValues() {
            const myos = myOS(); // OSによってデフォルト表示を切り替える
            const mcgcd = document.getElementById("mcgcd").value;
            // ポップアップウィンドウを非表示
            document.getElementById("jiqtyPopupWindow").style.display = "none";
            document.getElementById("irepoPopupWindow").style.display = "none";
            // テーブルの数分ループ処理
            for (tblno = 1; tblno < 15; tblno++){
                const tblobj = document.getElementById(`tbl${tblno}`);
                let compcount = 0; // 完了数
                if (tblobj) {
                    // 各テーブル内のデータ数分ループ処理
                    const endcol = tblobj.rows[1].cells.length - 1;
                    const thickness = Number(document.getElementById(`mcthick${tblno}`).value);     // 刃厚さ
                    const scraplen = Number(document.getElementById(`mcscrap${tblno}`).value);      // 端材長さ
                    let mateold = tblobj.rows[1].cells[2].innerHTML;
                    let colorno = 0;
                    for ( var i = 1; i < tblobj.rows.length; i++ ) {
                        // ０．変数セット
                        const productlen = Number(tblobj.rows[i].cells[3].innerHTML);               // 製品長さ
                        const materiallen = Number(tblobj.rows[i].cells[endcol - 1].innerHTML);     // 材料長さ
                        const zanqty = Number(tblobj.rows[i].cells[endcol - 4].innerHTML);          // 注文残数
                        const storeqty = Number(tblobj.rows[i].cells[endcol - 2].innerHTML);        // ストア在庫数
                        
                        // １．材料サイズ毎の色分け処理
                        const matenow = tblobj.rows[i].cells[2].innerHTML;
                        if (matenow != mateold) {
                            colorno = (colorno == 0) ? 1 : 0;
                            mateold = matenow;
                        }

                        // １．５ ストア在庫数のチェック
                        if (zanqty > storeqty) {
                            tblobj.rows[i].cells[endcol - 4].className = "warn";
                        }

                        // ２．鋼材情報行の追加
                        var newrow = tblobj.insertRow(i + 1);
                        appendTD(newrow, "", "center", 4);
                        appendTD(newrow, "", "center", 5);
                        appendTD(newrow, "", "center", 5);
                        appendTD(newrow, "", "center", 5);

                        // ３．鋼材使用長さの集計と、仕掛在庫の消込処理を同時に行う
                        let usedlenttl = Number("0.0");
                        for (var j=4; j<=9; j+=5) {
                            let usedlen = Number("0.0"); // 一週間で使用する鋼材長さを集計
                            for (var k=0; k<5; k++) {
                                if (!isNaN(tblobj.rows[i].cells[j+k].innerText) && tblobj.rows[i].cells[j+k].innerText != "") {
                                    // 3.1
                                    if (tblobj.rows[i].cells[j+k].classList.contains("s4") == false) {
                                        let qty = Number(tblobj.rows[i].cells[j+k].innerText);
                                        // 製品長さが入っていたら加算
                                        if (productlen > 0) {
                                            usedlen += (productlen + thickness) * qty;
                                            usedlenttl += (productlen + thickness) * qty;
                                        }
                                    }
                                    // 3.2 イベントハンドラー（実績入力ポップアップ呼び出し）
                                    const strQTY = tblobj.rows[i].cells[j+k].innerText;
                                    tblobj.rows[i].cells[j+k].innerHTML =
                                    `<a href="javascript:jissekiPopup(${tblno},${i},${j+k})" class="td-qty-a">` + strQTY + "</a>" ;
                                }
                            }
                            // 小数点第3位は切り捨て
                            if (usedlen > 0) {
                                var usedmate = Math.floor(usedlen / (materiallen - scraplen) * 100) / 100;
                                var usedmaterialtext = (materiallen==0) ? "鋼材長さ設定なし" : usedmate + "本";
                                tblobj.rows[i + 1].cells[(j==4) ? 1 : 2].innerText = usedmaterialtext + 
                                    " (" + usedlen.toLocaleString() + "mm)";
                            }
                        }
                        // ４．鋼材使用長さの集計結果を反映
                        if (usedlenttl > 0) {
                            var str = "材料：" + tblobj.rows[i].cells[2].innerHTML;
                            str += "、長さ：" + tblobj.rows[i].cells[3].innerHTML;
                            tblobj.rows[i + 1].cells[0].innerHTML = str;
                            tblobj.rows[i + 1].cells[0].className = "lef";
                            // 使用集計値 / (材料長さ-端材長さ) 100倍して小数点切り捨てして100で割って小数点以下第２位までを求める
                            var usedmate = Math.floor(usedlenttl / (materiallen - scraplen) * 100) / 100;
                            var usedmaterialtext = (materiallen==0) ? "鋼材長さ設定なし" : usedmate + "本";
                            tblobj.rows[i + 1].cells[3].innerText = usedmaterialtext + 
                                " (" + usedlenttl.toLocaleString() + "mm)";
                            }
                        // ５．材料の種類毎に背景色を変える
                        tblobj.rows[i + 0].style.backgroundColor = (colorno == 0) ? "#FEFEFE" : "#ECECEC";
                        tblobj.rows[i + 1].style.backgroundColor = (colorno == 0) ? "#FEFEFE" : "#ECECEC";
                        // ６．イベントハンドラー（i-Repo呼び出し）
                        if (tblobj.rows[i].cells[endcol].innerHTML != "") {
                            tblobj.rows[i].cells[endcol].innerHTML = `<a href="javascript:iReporter(${tblno},${i})" class="btn-irepo">` + "記入" + "</a>" ;
                        }
                        // ７．列(TD)の非表示化
                        tblobj.rows[i].cells[3].style.display = "none";                 // 長さ
                        tblobj.rows[i].cells[endcol - 1].style.display = "none";        // 鋼材長さ
                        if (myos != "windows") {
                            tblobj.rows[i].cells[endcol - 4].style.display = "none";    // 注文残
                            tblobj.rows[i].cells[endcol - 3].style.display = "none";    // 仕掛かり在庫数
                            tblobj.rows[i].cells[endcol - 2].style.display = "none";    // ストア在庫数
                        }
                        // ８．行(TR)の非表示化
                        tblobj.rows[i + 1].style.display = "none";    // 8.1.鋼材情報行は一旦非表示
                        if (zanqty == 0) {
                            tblobj.rows[i].style.display = "none";    // 8.2.注文残数が0の場合一旦非表示
                            compcount++;
                        }
                        // insertRowした分を加算
                        i++;
                    }
                    // 合計数量の表示
                    document.getElementById(`countResult${tblno}`).innerText =
                        `(完了${compcount}件 / ${(tblobj.rows.length-1)/2}件中)`;

                    // ヘッダー(TH)の非表示化
                    tblobj.rows[0].cells[3].style.display = "none";                     // 長さ
                    tblobj.rows[0].cells[endcol - 1].style.display = "none";            // 鋼材長さ
                    if (myos != "windows") {
                        tblobj.rows[0].cells[endcol - 4].style.display = "none";        // 注文残
                        tblobj.rows[0].cells[endcol - 3].style.display = "none";        // 仕掛かり在庫数
                        tblobj.rows[0].cells[endcol - 2].style.display = "none";        // ストア在庫数
                    } else {
                        document.getElementById(`chkzaiko${tblno}`).checked = true;
                    }
                }
            }
        }
        // 列の追加
        function appendTD(newrow, str, name, colspan){
            let newCell = newrow.insertCell();
            let newText = document.createTextNode(str);
            newCell.appendChild(newText);
            if (colspan != "") newCell.setAttribute("colspan", colspan);
            if (name != "") newCell.className = name;
        }

        // 指定した要素の位置までスクロール
        function jumpToSection(sectionId) {
            document.getElementById(sectionId).scrollIntoView({block: "center", behavior: "smooth"});
        }

        // チェックボックス手配情報の表示切り替え
        function checkTehaiChange(tblno) {
            const checkTehai = document.getElementById(`chktehai${tblno}`)
            const checkZaiko = document.getElementById(`chkzaiko${tblno}`)
            const checkMaterial = document.getElementById(`chkmate${tblno}`)
            const tblobj = document.getElementById(`tbl${tblno}`);
            const rows = tblobj.rows.length;
            const endcol = tblobj.rows[1].cells.length - 1;
            let zanqty = 0;
            // alert(tblobj.rows[2].cells[0].innerText)
            for( var i = 1; i < rows; i++ ){
                if (i % 2 != 0) { //通常の行
                    zanqty = Number(tblobj.rows[i].cells[endcol - 4].innerText); // 注文残数
                    if (checkTehai.checked == true) {
                        tblobj.rows[i].style.display = "";
                        if (checkMaterial.checked) tblobj.rows[i + 1].style.display = "";
                    } else if (zanqty > 0) {
                        tblobj.rows[i].style.display = "";
                        if (checkMaterial.checked == false) tblobj.rows[i + 1].style.display = "none";
                    } else {
                        tblobj.rows[i].style.display = "none";
                        tblobj.rows[i + 1].style.display = "none";
                    }
                }
            }
        }
        // チェックボックス在庫状況の表示切り替え
        function checkZaikoChange(tblno) {
            const checkDisp = document.getElementById(`chkzaiko${tblno}`)
            const tblobj = document.getElementById(`tbl${tblno}`);
            const row = tblobj.rows.length;
            const endcol = tblobj.rows[1].cells.length - 1;
            if (checkDisp.checked == false) {
                tblobj.rows[0].cells[endcol - 2].style.display = "none";
                tblobj.rows[0].cells[endcol - 3].style.display = "none";
                tblobj.rows[0].cells[endcol - 4].style.display = "none";
            } else {
                tblobj.rows[0].cells[endcol - 2].style.display = "";
                tblobj.rows[0].cells[endcol - 3].style.display = "";
                tblobj.rows[0].cells[endcol - 4].style.display = "";
            }
            for( var i = 1; i < row; i++ ){
                if (checkDisp.checked == false) {
                    if (i % 2 != 0) {
                        tblobj.rows[i].cells[endcol - 2].style.display = "none";
                        tblobj.rows[i].cells[endcol - 3].style.display = "none";
                        tblobj.rows[i].cells[endcol - 4].style.display = "none";
                    }
                } else {
                    if (i % 2 != 0) {
                        tblobj.rows[i].cells[endcol - 2].style.display = "";
                        tblobj.rows[i].cells[endcol - 3].style.display = "";
                        tblobj.rows[i].cells[endcol - 4].style.display = "";
                    }
                }
            }
        }
        // チェックボックス鋼材情報の表示切り替え
        function checkMateChange(tblno) {
            const checkDisp = document.getElementById(`chkmate${tblno}`)
            const tblobj = document.getElementById(`tbl${tblno}`);
            const row = tblobj.rows.length;
            const endcol = tblobj.rows[1].cells.length - 1;
            if (checkDisp.checked == false) {
                tblobj.rows[0].cells[3].style.display = "none";             // 長さ非表示
                tblobj.rows[0].cells[endcol - 1].style.display = "none";    // 鋼材長さ非表示
            } else {
                tblobj.rows[0].cells[3].style.display = "";
                tblobj.rows[0].cells[endcol - 1].style.display = "";
            }
            for( var i = 1; i < row; i++ ){
                if (checkDisp.checked == false) {
                    if (i % 2 == 0) {
                        tblobj.rows[i].style.display = "none";
                    } else {
                        tblobj.rows[i].cells[3].style.display = "none";
                        tblobj.rows[i].cells[endcol - 1].style.display = "none";
                    }
                } else {
                    tblobj.rows[i].style.display = "";
                    if (i % 2 != 0) {
                        tblobj.rows[i].cells[3].style.display = "";
                        tblobj.rows[i].cells[endcol - 1].style.display = "";
                    }
                }
            }
        }

        // カスタムURLスキームによるシステム連携（apem図面サーバーへのリンク）(0:Windows, 1:iPad)
        function apemCustomURL(mode, hmcd) {
            const apemurl = "http://apemsv/PEMasterEM/docspace/sdk/";
            const modetext = (mode == 0) ? "contentView.do" : "download.do";
            const apemparam1 = 
                "?enc=UTF-8&service=cn%3Ddrep_service%40APEMSV%2Cou%3Dcomponents%2Cdc%3DAPEMEM" + 
                `&workspace=${encodeURI("図面検索")}&condition=${encodeURI("全図面検索")}&item=0%3Aoperator%3AexactlyMatch`;
            const apemparam2 = 
                `&item=0%3Avalue%3A${hmcd}&item=7%3Aoperator%3Aboolean&item=7%3Avalue%3Atrue`;
            // 図面表示またはダウンロード
            location.href = `${apemurl}${modetext}${apemparam1}&${apemparam2}`;
        }

        /* ポップアップ関連 ここから */
            const inputBox = document.getElementById("inputJIQTY");
            // イベントリスナー（フォーカス時全選択）（アロー関数編）
            inputBox.addEventListener("focus", event => event.target.select());
            // イベントリスナー（キーダウン）（無名関数編）
            inputBox.addEventListener("keydown", function(event) {
                if (event.key == "Enter") inputBox.blur();
            });

            // i-Reporter 選択ポップアップ画面の起動
            async function iReporter(tblno, row) {
                // 呼び出し元の基本情報取得
                const tblobj = document.getElementById(`tbl${tblno}`);
                const hmcd = tblobj.rows[row].cells[0].innerText;
                const mcgcd = document.getElementById("mcgcd").value;
                const mccd = document.getElementById(`mccd${tblno}`).value;
                // iRepo情報の取得API
                const irepoinfo = await this.getDefid(hmcd, mcgcd, mccd);
                if (!irepoinfo) return;
                // 直接呼出し工程（値やフラグを渡してあげないといけない）
                if (mcgcd == "SW") {
                    const repid = await getHoldid(irepoinfo.DEFID, hmcd, irepoinfo.HMCDCID);
                    iRepoCustomURL(tblno, row, mcgcd, hmcd, irepoinfo.DEFID, irepoinfo.HMCDCID, repid)

                // ポップアップで選択工程
                } else {
                    const table = document.getElementById("irepoPopupTable");
                    // ポップアップウィンドウに値をセット
                    document.getElementById("ipopHMCD").innerText = hmcd;
                    // 一覧を一旦削除
                    do {
                        if (table.rows.length > 2) {table.deleteRow(-1);}
                    } while (table.rows.length > 2);
                    // 一覧の取得
                    const viewreport = await this.getViewReport(irepoinfo.DEFID);
                    if (!viewreport) {
                        const msg = `帳票定義ID:${irepoinfo.DEFID} が本番環境に移行されていません．`;
                        document.getElementById("oldReport").innerText = msg;
                    } else if (viewreport.rowCount == 0) {
                        const msg = `過去に入力した帳票は存在しません．`;
                        document.getElementById("oldReport").innerText = msg;
                    } else {
                        document.getElementById("oldReport").innerText = 
                            "チェックシート一覧（最新の10件を表示、タップして過去履歴の呼び出し）";
                        // APIで取得したデータをテーブ行に追加
                        viewreport.rows.forEach(function (d) {
                            let newRow = table.insertRow();
                            appendTD(newRow, d.rep_top_id, "small", 1);
                            appendTD(newRow, d.rep_top_name, "small lef", 1);
                            appendTD(newRow, d.edit_refer_status, "", 1);
                            appendTD(newRow, d.sys_regist_time, "small", 1);
                            appendTD(newRow, d.sys_update_time, "small", 1);
                            // 帳票IDを起動
                            newRow.addEventListener("click", () => {
                                location.href = `jp.co.cimtops.ireporter.openreport:repid=${d.rep_top_id}`;
                                document.getElementById("irepoPopupWindow").style.display = "none";
                            });
                        });
                    };
                    // 新規帳票起動イベントリスナー設定
                    document.getElementById("newReport").addEventListener("click", () => {
                        location.href = `jp.co.cimtops.ireporter.createreport:defid=${irepoinfo.DEFID}`;
                        document.getElementById("irepoPopupWindow").style.display = "none";
                    });
                    // 閉じるイベントリスナー設定
                    document.getElementById("irepoClose").addEventListener("click", () => {
                        document.getElementById("irepoPopupWindow").style.display = "none";
                    });
                    // ポップアップウィンドウを表示
                    document.getElementById("irepoPopupWindow").style.display = "flex";
                }
            }
            // カスタムURLスキームによるシステム連携
            function iRepoCustomURL(tblno, row, mcgcd, hmcd, defid, clusterno, repid) {
                // iRepo呼び出し用データの取得
                const tblobj = document.getElementById(`tbl${tblno}`);
                const irepourl = "jp.co.cimtops.ireporter";
                
                // 新規帳票定義を起動
                if (repid == 0) {
                    if (mcgcd == "SW") {
                        // 選択されたデータをセットして帳票定義IDを起動
                        const mate = tblobj.rows[row].cells[2].innerText;
                        const cut = tblobj.rows[row].cells[3].innerText;
                        const hmcdparam = encodeURI(`スキャン品番=${hmcd}`);
                        const mateparam = encodeURI(`材料サイズ=${mate}`);
                        const cutparam = encodeURI(`切断長=${cut}`);
                        const modeparam = encodeURI("処理モード=order"); // 手配モードで帳票を起動
                        location.href = `${irepourl}.createreport:defid=${defid}` +
                            `&${hmcdparam}&${mateparam}&${cutparam}&${modeparam}`;
                    } else {
                        // 帳票定義IDをそのまま起動
                        location.href = `${irepourl}.createreport:defid=${defid}`;
                    }
                    /*browserTabClose();*/

                // 保留中の帳票IDから起動
                } else {
                    
                    location.href = `${irepourl}.openreport:repid=${repid}`;
                    /*browserTabClose();*/
                }
            }
            // 保留中の帳票IDを取得
            async function getHoldid(defid, hmcd, clusterno) {
                let customurl = "";
                if (clusterno == 0) {
                    customurl = `/ireposv/getHoldid/${defid}`;
                } else {
                    customurl = `/ireposv/getHoldid/${defid}:${hmcd}:${clusterno}`;
                }
                // irepoサーバーから編集中帳票ID取得API
                const res = await fetch(customurl);
                const repid = await res.json();
                return repid;
            }
            // 帳票一覧を取得
            async function getViewReport(defid) {
                const res = await fetch(`/ireposv/getViewReport/${defid}`);
                const viewreport = await res.json();
                return viewreport;
            }
            // 品番と設備Gと設備コードから帳票IDと品番クラスター番号を取得
            async function getDefid(hmcd, mcgcd, mccd) {
                try {
                    const res = await fetch(`/mysqlsv/getDefid/${hmcd}:${mcgcd}:${mccd}:`);
                    const data = await res.json();
                    if (data.DEFID == 0) {
                        alert("起動する帳票IDがマスター登録されていません．");
                        return null;
                    }
                    return data;
                } catch (err) {
                    alert(err);
                    return null;
                }
            }
            
            // 実績入力ポップアップの起動
            async function jissekiPopup(tblno, row, col) {
                // 呼び出し元の基本情報取得
                //alert(tblno + " - " + row + ":" +col)
                let tblobj = document.getElementById(`tbl${tblno}`);
                let mcgcd = document.getElementById("mcgcd").value;
                let mccd = document.getElementById(`mccd${tblno}`).value;
                let hmcd = tblobj.rows[row].cells[0].innerText;
                let stdttext = tblobj.rows[0].cells[4].innerText;
                let eddttext = tblobj.rows[0].cells[col].innerText;
                let d = new Date();
                let stdt = d.getFullYear() + "-" + stdttext.replace("/", "-");
                let eddt = d.getFullYear() + "-" + eddttext.replace("/", "-");
                let odrqty = tblobj.rows[row].cells[col].innerText;
                if (flgSubmit) return;
                flgSubmit = true;
                // 品番,設備,手配日付から、注文番号[ODRNO],手配状態[ODRSTS],実績数[JIQTY],未来の実績数[FUTUREQTY],過去の実績残数[ZANQTY]を取得するAPI
                fetch(`/mysqlsv/getOdrno/${hmcd}:${mcgcd}:${mccd}:${eddt}:${stdt}:`)
                .then(response => response.json())
                .then(data => {
                    flgSubmit = false;
                    /*// タップした行から4行前の行を最上部にスクロール
                    if (row > 4) {
                        tblobj.rows[row - 4].scrollIntoView({block: "start", behavior: "smooth"});
                        tblobj.rows[row].cells[col].classList.add("highlight"); // タップしたセルが分かるようハイライトを追加
                    }
                    廃止    */
                    // ポップアップウィンドウに値をセット
                    let odrno = data.ODRNO;
                    let odrsts = data.ODRSTS; //旧：tblobj.rows[row].cells[col].className.substr(1,1);
                    document.getElementById("jpopHMCD").innerText = hmcd;
                    document.getElementById("jpopODRNO").innerText = odrno;
                    document.getElementById("jpopODRSTS").innerText = (odrsts=="1") ? "着手中" : (odrsts=="2") ? "着手前" : (odrsts=="3") ? "着手" : (odrsts=="4") ? "完了" : (odrsts=="9") ? "取消" : "不明";
                    document.getElementById("jpopEDDT").innerText = eddttext;
                    document.getElementById("jpopODRQTY").innerText = odrqty;
                    document.getElementById("jpopJIQTY").innerText = data.JIQTY;
                    document.getElementById("jpopFUTUREODR").innerText = data.FUTUREODR;
                    document.getElementById("jpopFUTUREQTY").innerText = data.FUTUREQTY;
                    document.getElementById("jpopMCCD").value = mccd;
                    document.getElementById("jpopTBLNO").value = tblno;
                    document.getElementById("jpopROW").value = row;
                    document.getElementById("jpopCOL").value = col;
                    inputBox.value = "";
                    // 使用可能ボタンを判定
                    const startObj = document.getElementById("jiqtyStart");
                    const finishObj = document.getElementById("jiqtyEntry");
                    const modifyObj = document.getElementById("jiqtyModify");
                    startObj.classList.remove("disable");
                    finishObj.classList.remove("disable");
                    modifyObj.classList.remove("disable");
                    if (odrsts == "1") {
                        startObj.classList.add("disable");
                        if (Number(data.ZANQTY) != 0) finishObj.classList.add("disable");
                        modifyObj.classList.add("disable");
                    } else if (odrsts == "2") {
                        if (Number(data.ZANQTY) != 0) startObj.classList.add("disable");
                        if (Number(data.ZANQTY) != 0) finishObj.classList.add("disable");
                        modifyObj.classList.add("disable");
                    } else if (odrsts == "3") {
                        startObj.classList.add("disable");
                        if (Number(data.JIQTY) == 0) modifyObj.classList.add("disable");
                    } else if (odrsts == "4") {
                        startObj.classList.add("disable");
                        finishObj.classList.add("disable");
                        if (Number(data.FUTUREQTY) != 0) modifyObj.classList.add("disable");
                    } else {
                        startObj.classList.add("disable");
                        finishObj.classList.add("disable");
                        modifyObj.classList.add("disable");
                    }
                    // 閉じるイベントリスナー設定
                    document.getElementById("jiqtyClose").addEventListener("click", () => {
                        tblobj.rows[row].cells[col].classList.remove("highlight");
                        document.getElementById("jiqtyPopupWindow").style.display = "none";
                    });
                    // ポップアップウィンドウを表示
                    document.getElementById("jiqtyPopupWindow").style.display = "flex";
                    inputBox.focus();
                }); 
            }
            // 表示されているポップアップウィンドウの場所を変更
            function w(justifyname, alignname) {
                document.getElementById("jiqtyPopupWindow").style.justifyContent = justifyname;
                document.getElementById("jiqtyPopupWindow").style.alignItems = alignname;
            }
            // 数値キーパッド処理
            function i(numpad) {
                if (inputBox.value.length >= 4) return;
                inputBox.value += numpad;
            }
            // BS処理
            function inputBS() {
                inputBox.value = inputBox.value.slice(0, inputBox.value.length - 1);
            }
            // Clear処理
            function inputClear() {
                inputBox.value = "";
                inputBox.focus();
            }
            // イコール＝処理
            function equalqty() {
                inputBox.value = document.getElementById("jpopODRQTY").innerText
            }
            // 作業開始
            function orderStart() {
                let odrno = document.getElementById("jpopODRNO").innerText;
                let tblno = document.getElementById("jpopTBLNO").value;
                let mcgcd = document.getElementById("mcgcd").value;
                let mccd = document.getElementById("jpopMCCD").value;
                let row = document.getElementById("jpopROW").value;
                let col = document.getElementById("jpopCOL").value;
                const tblobj = document.getElementById(`tbl${tblno}`);
                const popWin = document.getElementById("jiqtyPopupWindow");
                fetch(`/mysqlsv/startOrder/${odrno}:${mcgcd}:${mccd}:`)
                .then(res => {if(!res.ok) {throw new Error(`${res.status} ${res.statusText}`);}})
                .then(data => {
                    tblobj.rows[row].cells[col].className = "s1";
                    popWin.style.display = "none";
                })
                .catch(err => {alert(err);});
            }
            // 実績登録
            async function orderEntry() {
                if (checkInputBox() == "false") {return;}
                let odrno = document.getElementById("jpopODRNO").innerText;
                let odrqty = Number(document.getElementById("jpopODRQTY").innerText);
                let jiqty = Number(document.getElementById("jpopJIQTY").innerText);
                let futureodr = Number(document.getElementById("jpopFUTUREODR").innerText);
                let futureqty = Number(document.getElementById("jpopFUTUREQTY").innerText);
                // 個別の入力ボックスチェック
                if ((odrqty - jiqty + futureodr) < Number(inputBox.value)) {
                    const msg = `実績数(${inputBox.value})が注文残数(${odrqty - jiqty + futureodr})をオーバーしています` + 
                        "\n余り分は仕掛り在庫として登録してよろしいですか？";
                    if (!window.confirm(msg)) {
                        inputBox.focus();
                        return;
                    }
                }
                let tblno = document.getElementById("jpopTBLNO").value;
                let mcgcd = document.getElementById("mcgcd").value;
                let mccd = document.getElementById("jpopMCCD").value;
                let row = document.getElementById("jpopROW").value;
                let col = document.getElementById("jpopCOL").value;
                const tblobj = document.getElementById(`tbl${tblno}`);
                const popWin = document.getElementById("jiqtyPopupWindow");
                try {
                    const response = await fetch(`/mysqlsv/finishOrder/${odrno}:${mcgcd}:${mccd}:${inputBox.value}:`)
                    const data = await response.json();
                    // ここでループ
                    data.forEach(function (d) {
                        let targetDate = new Date(d.EDDT);
                        // 対象日付を特定する為にループ
                        for (let i = 0; i < 10; i++) {
                            // 非表示列が１つあるので１減算
                            let c = Number(col) + i - 1;
                            let thstr = tblobj.rows[0].cells[c].innerText;
                            // 月を設定する場合は（0から11の範囲）で指定する事
                            let th = new Date(targetDate.getFullYear(), Number(thstr.split("/")[0]) - 1, thstr.split("/")[1]);
                            // 日付通しの比較の確認 
                            // alert(d.toLocaleDateString('en-CA') + ":" + targetDate.toLocaleDateString('en-CA')) ;
                            if (th.getFullYear() == targetDate.getFullYear() &&
                                th.getMonth() == targetDate.getMonth() &&
                                th.getDate() == targetDate.getDate()
                            ) {
                                tblobj.rows[row].cells[c].className = "s" + d.NEWSTS + " td-qty";
                                break;
                            }
                        }
                    });
                    popWin.style.display = "none";
                } catch (err) {
                    alert(err);
                }
            }
            // 共通の入力ボックスチェック
            function checkInputBox() {
                let errmsg = "";
                if (isNaN(inputBox.value)) errmsg = "数値を入力して下さい";
                if (inputBox.value == "") errmsg = "実績数を入力して下さい";
                if (errmsg != "") {
                    alert(errmsg);
                    inputBox.focus();
                    return "false";
                }
                return "true";
            }
            // 実績訂正
            async function orderModify() {
                if (checkInputBox() == "false") {return;}
                let odrno = document.getElementById("jpopODRNO").innerText;
                let odrqty = document.getElementById("jpopODRQTY").innerText;
                let preqty = document.getElementById("jpopJIQTY").innerText;
                if (Number(odrqty) < Number(inputBox.value)) {
                    alert("正しい数値を入力してください");
                    inputBox.focus();
                    return;
                }
                let tblno = document.getElementById("jpopTBLNO").value;
                let mcgcd = document.getElementById("mcgcd").value;
                let mccd = document.getElementById("jpopMCCD").value;
                let row = document.getElementById("jpopROW").value;
                let col = document.getElementById("jpopCOL").value;
                const tblobj = document.getElementById(`tbl${tblno}`);
                const popWin = document.getElementById("jiqtyPopupWindow");
                try {
                    const response = await fetch(`/mysqlsv/modifyOrder/${odrno}:${mcgcd}:${mccd}:${preqty}:${inputBox.value}:`)
                    const data = await response.json();
                    const newsts = data[data.length - 1].NEWSTS; // 最終手配ファイルのステータスを反映
                    tblobj.rows[row].cells[col].className = "s" + newsts + " td-qty";
                    popWin.style.display = "none";
                } catch (err) {
                    alert(err);
                }
            }



