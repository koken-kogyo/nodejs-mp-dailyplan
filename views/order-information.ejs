<body>
    <!-- Common JavaScript -->
    <%- include("_myfunctions.ejs") %>
    <% let osType = myRequestHeader.osType(req); %>

    <div id="top"></div>
    <div id="main" class="containers">

    <!-- Header -->
    <%- include("_header.ejs", { title: mcgcd + "工程　手配一覧", req }) %>
    <div id="gotoswmenu"><a href="javascript:window.close()"><i class="fas fa-home"></i></a></div>
    <input type="hidden" id="mcgcd" name="mcgcd" value="<%= mcgcd %>" />

    
    <!-- i-Reporter選択 Popup Window -->
    <div id="irepoPopupWindow" class="popwin-background">
        <div class="popwin-forward">
            <div class="popwin-modalbody">
                新規帳票の呼び出し
                一時保存帳票の呼び出し（一番古いもの）
                一時保存帳票の呼び出し（最新のもの）
                過去帳票の参照（最後に入力完了したもの）    
            </div>
            <div id="irepoClose" class="popwin-close">閉じる</div>
        </div>
    </div>

     <!-- Details -->
    <div id="details">
    <% if (kd8450) { %>
        <% const apemcontenturl = "http://apemsv/PEMasterEM/docspace/sdk/contentView.do?enc=UTF-8&service=cn%3Ddrep_service%40APEMSV%2Cou%3Dcomponents%2Cdc%3DAPEMEM&workspace=図面検索&condition=全図面検索&item=0%3Aoperator%3AexactlyMatch"; %>
        <% const apemdownloadurl = "http://apemsv/PEMasterEM/docspace/sdk/download.do?enc=UTF-8&service=cn%3Ddrep_service%40APEMSV%2Cou%3Dcomponents%2Cdc%3DAPEMEM&workspace=図面検索&condition=全図面検索&item=0%3Aoperator%3AexactlyMatch"; %>
        <% const wsenc = encodeURI("図面検索"); %>
        <% const condenc = encodeURI("全図面検索"); %>

        <% let tableno = 1; %>
        <% let mccount = Object.keys(kd8450).length; %>
        <% kd8450.forEach(function (data) { %>
            <div id="jump<%= tableno %>"></div>
            <input type="hidden" id="mccd<%= tableno %>" name="mccd<%= tableno %>" value="<%= data[0].MCCD %>" />
            <!-- 設備タイトル -->
            <div class="mcnm">
                <%= data[0].MCCD %>：<%= data[0].MCNM; %>
                <span class="smalltitle">
                <%= (data[0].CUTTHICKNESS==0) ? "（設備マスタに刃厚、端材長さの登録なし）" : "（刃厚：" + data[0].CUTTHICKNESS; %>
                <%= (data[0].SCRAPLEN==0) ? "" : "、端材長さ：" + data[0].SCRAPLEN + "）"; %>
                <input type="hidden" id="mcthick<%= tableno %>" name="mcthick" value="<%= data[0].CUTTHICKNESS %>" />
                <input type="hidden" id="mcscrap<%= tableno %>" name="mcscrap" value="<%= data[0].SCRAPLEN %>" />
                </span>
                <span class="floatright">
                <!-- チェックボックス -->
                在庫状況
                <input type="checkbox" id="chkzaiko<%= tableno %>" class="check-box" title="在庫状況" value="<%= tableno %>" onchange="checkZaikoChange(this.value)"/>
                鋼材情報を表示
                <input type="checkbox" id="chkmate<%= tableno %>" class="check-box" title="鋼材情報" value="<%= tableno %>" onchange="checkMateChange(this.value)"/>
                <% let prevsectionid = "jump" + (tableno - 1); %>
                <% let nextsectionid = "jump" + (tableno + 1); %>
                <% if (tableno == 2) { %>
                    <a href="#top">前の設備</a>
                <% } %>
                <% if (tableno >= 3) { %>
                    <a href="javascript:jumpToSection('<%= prevsectionid %>')">&nbsp;&nbsp;前の設備&nbsp;&nbsp;</a>
                <% } %>
                <% if (tableno != mccount) { %>
                    <a href="javascript:jumpToSection('<%= nextsectionid %>')">&nbsp;&nbsp;次の設備&nbsp;&nbsp;</a>
                <% } %>
                </span>
            </div>
            <hr>
            <!-- 明細 -->
            <% if (Object.keys(data[1]).length == 0) { %>
                <div class="nodata">データありません．</div>
            <% } else { %>
                <table id="tbl<%= tableno %>">
                    <tr>
                        <th width="160px">品番</th>
                        <th width="150px">品目名称</th>
                        <th width="40px">材料</th>
                        <th width="60px">長さ</th>
                        <% ymds.forEach(function (e) { %>
                            <th><%= myFunc.a(e); %></th>
                            <!-- a href="/mp/plan/<%- myFunc.b(e); %>"></a -->
                        <% }); %>
                        <th width="60px">注文残</th>
                        <th width="60px">仕掛</th>
                        <th width="60px">ｽﾄｱ</th>
                        <th width="100px">鋼材長さ</th>
                        <th width="80px">ﾁｪｯｸｼｰﾄ</th>
                        
                    </tr>
                    <% data[1].forEach(function (d) { %>
                    <tr>
                        <td class="lef td-big">
                            <% if (osType == "windows") { %>
                                <a href="<%= apemcontenturl %>&item=0%3Avalue%3A<%= d.HMCD %>&item=7%3Aoperator%3Aboolean&item=7%3Avalue%3Atrue" class="td-apem-a" target="_blank">
                            <% } else { %>
                                <a href="<%= apemdownloadurl %>&item=0%3Avalue%3A<%= d.HMCD %>&item=7%3Aoperator%3Aboolean&item=7%3Avalue%3Atrue" class="td-apem-a" target="_blank">
                            <% }; %>
                            <%= d.HMCD %></a>
                        </td>
                        <td class="lef"><%= d.HMNM %></td>
                        <td class=""><%= d.MATESIZE %></td>
                        <td class=""><%= d.LENGTH %></td>
                        <td class="s<%= d.STS0 %> td-qty"><%= d.D0 %></td>
                        <td class="s<%= d.STS1 %> td-qty"><%= d.D1 %></td>
                        <td class="s<%= d.STS2 %> td-qty"><%= d.D2 %></td>
                        <td class="s<%= d.STS3 %> td-qty"><%= d.D3 %></td>
                        <td class="s<%= d.STS4 %> td-qty"><%= d.D4 %></td>
                        <td class="s<%= d.STS5 %> td-qty"><%= d.D5 %></td>
                        <td class="s<%= d.STS6 %> td-qty"><%= d.D6 %></td>
                        <td class="s<%= d.STS7 %> td-qty"><%= d.D7 %></td>
                        <td class="s<%= d.STS8 %> td-qty"><%= d.D8 %></td>
                        <td class="s<%= d.STS9 %> td-qty"><%= d.D9 %></td>
                        <td class=""><%= Number(d.D0Z)+Number(d.D1Z)+Number(d.D2Z)+Number(d.D3Z)+Number(d.D4Z)+Number(d.D5Z)+Number(d.D6Z)+Number(d.D7Z)+Number(d.D8Z)+Number(d.D9Z) %></td>
                        <td class=""><%= (d.ZAIQTY == 0) ? "" : Number(d.ZAIQTY).toLocaleString(); %></td>
                        <td class=""><%= (d.STORE == 0) ? "" : Number(d.STORE).toLocaleString(); %></td>
                        <td class=""><%= d.MATERIALLEN %></td>
                        <td><%= (d.DEFID == 0) ? "" : d.DEFID %></td>
                    </tr>
                    <% }); %>
                </table>
            <% }; %>
            <% tableno += 1; %>
            <br><br>
        <% }); %>
    <% }; %>
    </div>
    </div>

    <!-- 実績入力 Popup Window -->
    <div id="jiqtyPopupWindow" class="popwin-background">
        <div id="jiqtyPopup">
            <div class="popwin-modalbody">
                <div id="jiqtyPopupTitle">
                    <div class="center">　　　実績入力</div>
                    <div id="jiqtyClose">閉じる</div>
                </div>
                <table id="jiqtyPopupTable">
                    <tr>
                        <th>品番</th>
                        <td class="left" colspan="3" id="popHMCD">-</td>
                    </tr>
                    <tr>
                        <th width="80px">注文番号</th>
                        <td width="110px" id="popODRNO">--</td>
                        <th width="80px">手配状態</th>
                        <td width="110px" id="popODRSTS">--</td>
                    </tr>
                    <tr>
                        <th>注文日付</th>
                        <td id="popEDDT">--</td>
                        <th>注文数</th>
                        <td id="popODRQTY">--</td>
                    </tr>
                    <tr>
                        <th>変更前</th>
                        <td id="popJIQTY">--</td>
                        <th>実績数</th>
