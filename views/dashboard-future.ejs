<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>注文ダッシュボード</title>
    <!-- View -->
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- CSS -->
    <link rel="stylesheet" href="/static/css/style-dashboard.css">
    <!-- Script -->
    <script src="/static/javascripts/chart.umd.min.js"></script>
    <script src="/static/javascripts/chartjs-adapter-date-fns.bundle.min.js"></script>
    <script src="/static/javascripts/chartjs-plugin-datalabels.min.js"></script>
</head>
<body>
    <!-- Common JavaScript -->
    <%- include("_myfunctions.ejs") %>
    <% let osType = myRequestHeader.osType(req); %>

    <!-- Main-Container -->
    <div id="main" class="containers">

        <!-- Header -->
        <header>
            注文ダッシュボード
            <div id="titledatetime">2026年1月1日(気) 17時57分</div>
        </header>

        <!-- Details -->
        <a href="javascript:toDashboard();"><div id="btnprev" class="arrowright"></div></a>
        <div id="dashboard-main" class="<%= locals.animation %>">


            <!-- Chart Item -->
            <div id="f-dashboard1" class="dashboard-bg">
                <canvas id="chart1"></canvas>
            </div>

            <!-- Chart Item -->
            <div id="f-dashboard2" class="dashboard-bg">
                <canvas id="chart2"></canvas>
            </div>

            <!-- Chart Item -->
            <div id="f-dashboard3" class="dashboard-bg">
                <canvas id="chart3"></canvas>
            </div>

        </div>

        <!-- Popup Window -->
        <div id="popup-window" class="popwin-background popwin-modalbody" onClick="javascript:noneDelayList();">
            <div id="popup-delay">
                <table id="delayPopupTable" onClick="javascript:noneDelayList();">
                    <tr>
                        <th>品番</th>
                        <th>品名</th>
                        <th>材料</th>
                        <th>工程経路</th>
                        <th>注文数</th>
                        <th>CT</th>
                        <th>OT</th>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <%- include("_footer.ejs", req) %>
    
    </div>
    <!-- ブラウザ読み込み完了後のJavaScriptを記述 -->
    <script src="/static/javascripts/_myfunctions.js"></script>
    <script src="/static/javascripts/dashboard-future.js"></script>
    <script>
        // オブジェクト変数
        const mainObj = document.getElementById("main");
        const dashboardMainObj = document.getElementById("dashboard-main");
        const dashboardObj1 = document.getElementById("f-dashboard1");
        const dashboardObj2 = document.getElementById("f-dashboard2");
        const dashboardObj3 = document.getElementById("f-dashboard3");
        const titleDateTimeObj = document.getElementById('titledatetime');
        const todaysGoalObj = document.getElementById("todays-goal");
        const delaysGoalObj = document.getElementById("delays-goal");
        const todaysResultObj = document.getElementById("todays-result");
        const delaysResultObj = document.getElementById("delays-result");
        const todaysRemainObj = document.getElementById("todays-remain");
        const delaysRemainObj = document.getElementById("delays-remain");
        const screenSizeElement = document.getElementById("responsible");
        const popDelayObj = document.getElementById("popup-window");
        popDelayObj.style.zIndex = -9;

        // １．タイトル日時更新
        function getTitleDateTime() {
            const days = ["(日)", "(月)", "(火)", "(水)", "(木)", "(金)", "(土)"];
            let date = new Date()
            let year = date.getFullYear()   // 年
            let month = date.getMonth() + 1 // 月
            let day = date.getDate()        // 日
            let hour = date.getHours()      // 時
            let minute = date.getMinutes()  // 分
            let second = date.getSeconds()  // 秒
            let timeText = `${year}年${month}月${day}日${days[date.getDay()]} ${hour}時${minute.toString().padStart(2, "0")}分`
            return timeText;
        }
        // 15秒ごとのタイマー処理
        const checkServerID = setInterval(() => {
            titleDateTimeObj.textContent = getTitleDateTime();  // １．日付更新
        }, 15 * 1000);

        
        // ２．ダッシュボード用データ取得
        function getDashboardFuture() {
            fetch("/mysqlsv/dashboard/future")
            .then(res => res.json())
            .then(data => {
                dashboardObj1.style.opacity = 1;
                dashboardObj1.style.zIndex = 1;
                dashboardObj2.style.opacity = 0;
                dashboardObj2.style.zIndex = -9;
                dashboardObj3.style.opacity = 0;
                dashboardObj3.style.zIndex = -9;
                drawChart1(data.labels, data.ktnkbn, data.thisweekworks, data.thisweekdandori, data.nextweekworks, data.nextweekdandori);
                drawChart2("", "", "", "", "", ""); // デフォルトchartオブジェクトを作成しておく
                drawChart3("", "", "", "", "", ""); // デフォルトchartオブジェクトを作成しておく
            })
            .catch(err => {alert(err);});
        }


        // ３．画面サイズ変更イベント
        function updateScreenSize() {
            const width1 = window.innerWidth;
            const width2 = Math.round(window.visualViewport.width); /* Andoroid携帯だけ小数点で入ってくる為四捨五入して整数 */
            const width = (width1 != width2) ? `${width1}:${width2}` : `${width1}`; 
            const height = window.innerHeight;
            screenSizeElement.innerText = `W:${width}*H:${height}`;
        }
        window.addEventListener('resize', updateScreenSize);


        // ４．ダッシュボードへ移動
        function toDashboard() {
           dashboardMainObj.className = "slideout_toright"; // CSSアニメーションが再発火しない対策
            setTimeout(() => {
                window.location.href = "/mp/todashboard/fromfuture"; // 右のページに遷移
            }, 100);
        }


        // ５．ダッシュボードトップへ移動
        function toDashboardTop() {
            dashboardObj1.style.opacity = 1;
            dashboardObj1.style.zIndex = 1;
            dashboardObj2.style.opacity = 0;
            dashboardObj2.style.zIndex = -9;
            dashboardObj3.style.opacity = 0;
            dashboardObj3.style.zIndex = -9;
        }


        // ６．ダッシュボード工程一覧へ移動
        function toDashboardGCD() {
            dashboardObj1.style.opacity = 0;
            dashboardObj1.style.zIndex = -9;
            dashboardObj2.style.opacity = 1;
            dashboardObj2.style.zIndex = 1;
            dashboardObj3.style.opacity = 0;
            dashboardObj3.style.zIndex = -9;
        }


        // ７．ブラウザ読み込み完了後の初期設定
        function SetInitialValues() {
            // ポップアップウィンドウを隠す
            popDelayObj.style.display = "none";
            // タイトル日付初期セット
            titleDateTimeObj.textContent = getTitleDateTime();
            // 初期データ取得
            getDashboardFuture();
            // 時間差でスクリーンサイズを取得（スライドインアニメーションが完了した後でないと正しく取得できない）
            setTimeout(() => {
                dashboardMainObj.className = ""; // スライドインスタイルのクリア
                updateScreenSize();
            }, 100);
        }


        // ******************* ウィンドウズのデバイス対応 *************************
        // キーボードイベントを監視
        document.addEventListener("keydown", function(event) {
            switch (event.key) {
                case "ArrowLeft": // 左矢印キー
                    toDashboard();
                    break;
                default:// 他のキーは無視
                    break;
            }
        });

        // ******************* タブレットのスワイプ対応 *************************
        let startX = 0;
        let startY = 0;
        let endX = 0;
        let endY = 0;

        // タッチ開始時の座標を取得
        mainObj.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
        });

        // タッチ終了時の座標を取得
        mainObj.addEventListener('touchend', (e) => {
            endX = e.changedTouches[0].clientX;
            endY = e.changedTouches[0].clientY;
            detectSwipe();
        });

        // スワイプ方向を判定
        function detectSwipe() {
            const diffX = endX - startX;
            const diffY = endY - startY;
            if (Math.abs(diffX) > Math.abs(diffY)) {
                // 横方向のスワイプ
                if (diffX > 250) {
                    screenSizeElement.textContent = '右スワイプを検出しました！';
                    toDashboard();
                } else if (diffX < -250) {
                    screenSizeElement.textContent = '左スワイプを検出しました！';
                    window.location.reload();
                }
            } else {
                /*// 縦方向のスワイプ
                if (diffY > 50) {
                    screenSizeElement.textContent = '下スワイプを検出しました！';
                    window.location.reload();
                } else if (diffY < -150) {
                    screenSizeElement.textContent = '上スワイプを検出しました！';
                    if (confirm("ポータルサイトに移動しますか？")) {
                        window.location.href = "https://" + window.location.hostname;
                    }
                }*/
            }
        }

        // ブラウザ読み込み完了後の初期設定
        SetInitialValues();

    </script>

</body>
</html>
