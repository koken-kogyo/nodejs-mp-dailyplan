<!-- mp-index.ejs -->
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>促進表</title>
    <link rel="stylesheet" href="/static/css/style-basic.css">
    <link rel="stylesheet" href="/static/css/style-mppages.css">
</head>
<body>
    <!-- Common JavaScript -->
    <%- include("_myfunctions.ejs") %>
    <% let osType = myRequestHeader.osType(req); %>

    <!-- Header -->
    <%- include("_header.ejs", { title: "切削工程　促進表", req }) %>

    <!-- Groups -->
    <%- include("_mcgmenu.ejs", {mcgcdmenu, req, flgs: "0"}) %>

    <!-- Details -->
    <div id="top"></div>
    <div id="main" class="containers">
    <div id="details">
    <% if (req.session.mcgcd && d0410) { %>
        <% d0410.forEach(function (data) { %>
        <div class="mcnm"><%= data[0].MCCD %>：<%= data[0].MCNM %></div>
        <hr>
        <% if (Object.keys(data[1]).length == 0) { %>
            <div class="nodata">データありません．</div>
        <% } else { %>
        <table>
            <tr>
                <th width="120px">品番</th><th width="190px">品目名称</th><th width="60px">材料</th>
                <% ymds.forEach(function (e) { %>
                    <th><a href="/mp/plan/<%- myFunc.b(e); %>"><%= myFunc.a(e); %></a></th>
                <% }); %>
            </tr>
            <% data[1].forEach(function (d) { %>
            <tr>
                <td class="lef">
                    <% if (osType == "windows") { %>
                        <!-- a href="http://apemsv/PEMasterEM/docspace/sdk/contentView.do?enc=UTF-8&service=cn%3Ddrep_service%40APEMSV%2Cou%3Dcomponents%2Cdc%3DAPEMEM&workspace=図面検索&condition=koSearch&item=0%3Aoperator%3AexactlyMatch&item=0%3Avalue%3A<%= d.HMCD %>&item=6%3Aoperator%3Aboolean&item=6%3Avalue%3Atrue" target="_blank" -->
                        <a href="http://apemsv/PEMasterEM/docspace/sdk/contentView.do?enc=UTF-8&service=cn%3Ddrep_service%40APEMSV%2Cou%3Dcomponents%2Cdc%3DAPEMEM&workspace=図面検索&condition=全図面検索&item=0%3Aoperator%3AexactlyMatch&item=0%3Avalue%3A<%= d.HMCD %>&item=7%3Aoperator%3Aboolean&item=7%3Avalue%3Atrue" target="_blank">
                    <% } else { %>
                        <!-- a href="http://apemsv/PEMasterEM/docspace/sdk/download.do?enc=UTF-8&service=cn%3Ddrep_service%40APEMSV%2Cou%3Dcomponents%2Cdc%3DAPEMEM&workspace=図面検索&condition=oyaSearch&item=0%3Aoperator%3AexactlyMatch&item=0%3Avalue%3A<%= d.HMCD %>&item=6%3Aoperator%3Aboolean&item=6%3Avalue%3Atrue" target="_blank" -->
                        <a href="http://apemsv/PEMasterEM/docspace/sdk/download.do?enc=UTF-8&service=cn%3Ddrep_service%40APEMSV%2Cou%3Dcomponents%2Cdc%3DAPEMEM&workspace=図面検索&condition=全図面検索&item=0%3Aoperator%3AexactlyMatch&item=0%3Avalue%3A<%= d.HMCD %>&item=7%3Aoperator%3Aboolean&item=7%3Avalue%3Atrue" target="_blank">
                    <% }; %>
                    <%= d.HMCD %></a>
                </td>
                <td class="lef"><%= d.HMNM %></td><td class="lef"><%= d.MATESIZE %></td>
                <td class="s<%= d.STS0 %>"><%= d.D0 %></td><td class="s<%= d.STS1 %>"><%= d.D1 %></td>
                <td class="s<%= d.STS2 %>"><%= d.D2 %></td><td class="s<%= d.STS3 %>"><%= d.D3 %></td>
                <td class="s<%= d.STS4 %>"><%= d.D4 %></td><td class="s<%= d.STS5 %>"><%= d.D5 %></td>
                <td class="s<%= d.STS6 %>"><%= d.D6 %></td><td class="s<%= d.STS7 %>"><%= d.D7 %></td>
                <td class="s<%= d.STS8 %>"><%= d.D8 %></td><td class="s<%= d.STS9 %>"><%= d.D9 %></td>
            </tr>
            <% }); %>
        </table>
        <% }; %>
        <br><br>
        <% }); %>
    <% }; %>
    </div>
    </div>

    <!-- Footer -->
    <%- include("_footer.ejs", req) %>
    
</body>
</html>
